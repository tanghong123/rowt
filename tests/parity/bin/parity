#!/usr/bin/env bash
#
# parity — the differential harness (PORTING.md §6.2).
#
# Runs rowt inside a sandbox that cannot touch this machine: XDG_CONFIG_HOME and
# HOME point at a scratch tree, and every effectful or environment-reading
# command is a recorder shim on PATH. Each run captures four artifacts:
#
#   stdout / stderr / rc     what the user sees
#   trace                    every shimmed command, with its argv (§6.4)
#   fsstate                  the config dir afterwards — proves the on-disk
#                            formats invariant instead of asserting it (§6.4)
#
#   parity list              show the command matrix
#   parity run <id>          run one matrix entry, keep the artifacts
#   parity run -- <args…>    run an ad-hoc rowt command line
#   parity mask              bash-vs-bash over the matrix; report what still
#                            differs after normalize.sed (the Phase 0 gate)
#   parity golden            classifier verdicts vs the committed golden
#   parity corpus            replay the generated corpus through the classifier
#   parity render-diff       one render case, bash vs Rust, compared canonically
#   parity render-matrix     every render case (the Phase 1 gate)
#   parity ledger            regenerate LEDGER.md from bin/rowt
#
# `mask` compares bash against itself — it characterizes, it does not compare
# implementations. The cross-implementation gates are `render-diff`/`render-matrix`
# today, and grow to the whole command surface as later phases port it.
set -euo pipefail

SELF="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIR="$(cd -P "$SELF/.." && pwd)"                 # tests/parity
ROOT="$(cd -P "$DIR/../.." && pwd)"              # repo root
ROWT="${PARITY_ROWT:-$ROOT/bin/rowt}"
MATRIX="$DIR/commands.txt"
NORMALIZE="$DIR/normalize.sed"
TIMEOUT="${PARITY_TIMEOUT:-25}"

# Every command that reads or changes machine state. Anything not listed runs
# for real — fine for jq/awk/python3, which are deterministic given their input.
SHIMS="sudo networksetup launchctl limactl scutil ipconfig ifconfig route netstat
sysctl dscacheutil dig curl open brew tailscale pkill killall softwareupdate
system_profiler security osascript defaults sing-box"

die() { echo "parity: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------- matrix

matrix_rows() {  # id<TAB>flags<TAB>args…
  sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$MATRIX" \
    | while read -r id flags args; do printf '%s\t%s\t%s\n' "$id" "$flags" "$args"; done
}

matrix_get() {   # $1=id -> flags<TAB>args
  matrix_rows | awk -F'\t' -v i="$1" '$1==i {print $2 "\t" $3; found=1} END{exit !found}'
}

# ---------------------------------------------------------------- sandbox

# A scenario is a machine state the base fixtures do not describe — the proxy
# already on, a portal episode in progress, a VPN up. It overlays both halves of
# the sandbox: `config/` (what rowt has recorded) and `env/` (what the machine
# answers). Selected from the matrix with PARITY_SCENARIO=<name>.
make_sandbox() { # $1=outdir  [$2=scenario]
  local out="$1" scenario="${2:-}" cfg
  mkdir -p "$out"
  cfg="$out/home/rowt"                       # XDG_CONFIG_HOME=$out/home
  mkdir -p "$cfg" "$out/home" "$out/shims" "$out/env"
  cp -R "$DIR/fixtures/config/." "$cfg/"
  cp -R "$DIR/fixtures/env/." "$out/env/"
  if [ -n "$scenario" ]; then
    [ -d "$DIR/fixtures/scenarios/$scenario" ] || die "no such scenario: $scenario"
    [ -d "$DIR/fixtures/scenarios/$scenario/config" ] && cp -R "$DIR/fixtures/scenarios/$scenario/config/." "$cfg/"
    [ -d "$DIR/fixtures/scenarios/$scenario/env" ]    && cp -R "$DIR/fixtures/scenarios/$scenario/env/." "$out/env/"
  fi
  mkdir -p "$cfg/bin" "$cfg/log" "$cfg/cache"
  cp "$DIR/fixtures/bin/sing-box" "$cfg/bin/sing-box"
  chmod +x "$cfg/bin/sing-box"
  local s
  for s in $SHIMS; do ln -sf "$DIR/shims/_recorder" "$out/shims/$s"; done
}

scenario_of() { # echo the PARITY_SCENARIO value out of a VAR=VALUE list
  local e
  for e in "$@"; do case "$e" in PARITY_SCENARIO=*) printf '%s' "${e#PARITY_SCENARIO=}"; return 0 ;; esac; done
}

# A matrix entry may lead with VAR=VALUE tokens: some behavior is selected by
# environment rather than argv (ROWT_CAPTIVE_URL picks which portal the watchdog
# sees), and that dimension has to be reachable from the matrix. Parsed inline
# on purpose — a helper would have to return the array through a subshell, which
# silently drops it.
run_in() {       # $1=outdir (sandbox already built)  rest=rowt args — stdout only
  local out="$1"; shift
  local -a ENVS=()
  while [ "$#" -gt 0 ]; do
    case "$1" in [A-Z_]*=*) ENVS+=("$1"); shift ;; *) break ;; esac
  done
  env -i \
    ${ENVS[@]+"${ENVS[@]}"} \
    HOME="$out/home" \
    XDG_CONFIG_HOME="$out/home" \
    PATH="$out/shims:/usr/bin:/bin:/usr/sbin:/sbin" \
    TERM=dumb LC_ALL=C TZ=UTC \
    PARITY_TRACE="$out/trace" \
    PARITY_ENV="$out/env" \
    ROWT_IMPL="${ROWT_IMPL:-bash}" \
    perl -e 'alarm shift; exec @ARGV' "$TIMEOUT" \
    bash "$ROWT" "$@" 2>/dev/null || true
}

run_one() {      # $1=outdir  rest=rowt args
  local out="$1"; shift
  local rc=0
  local -a ENVS=()
  while [ "$#" -gt 0 ]; do
    case "$1" in [A-Z_]*=*) ENVS+=("$1"); shift ;; *) break ;; esac
  done
  make_sandbox "$out" "$(scenario_of ${ENVS[@]+"${ENVS[@]}"})"
  # perl's alarm is the same timeout trick rowt itself uses (_tmo) — it keeps a
  # `tail -f`-style command from wedging the harness.
  env -i \
    ${ENVS[@]+"${ENVS[@]}"} \
    HOME="$out/home" \
    XDG_CONFIG_HOME="$out/home" \
    PATH="$out/shims:/usr/bin:/bin:/usr/sbin:/sbin" \
    TERM=dumb LC_ALL=C TZ=UTC \
    PARITY_TRACE="$out/trace" \
    PARITY_ENV="$out/env" \
    ROWT_IMPL="${ROWT_IMPL:-bash}" \
    perl -e 'alarm shift; exec @ARGV' "$TIMEOUT" \
    bash "$ROWT" "$@" >"$out/stdout" 2>"$out/stderr" || rc=$?
  echo "$rc" > "$out/rc"
  [ -f "$out/trace" ] || : > "$out/trace"   # exists even when nothing was shimmed
  snapshot_fs "$out"
}

snapshot_fs() {  # $1=outdir — the config tree, minus what is volatile by design
  local out="$1" cfg="$1/home/rowt"
  ( cd "$cfg" 2>/dev/null || exit 0
    find . -type f \
      ! -path './log/*' ! -name '*.pid' ! -path './cache/*' ! -path './bin/*' \
      | sort | while read -r f; do
          # Checksum the NORMALIZED content: a file whose body carries a
          # timestamp (rowt report's saved diag) would otherwise differ on every
          # run and drown out the real on-disk-format signal.
          printf '%s  %s\n' "$(normalize "$f" "$out" | cksum | awk '{print $1}')" "$f"
        done
  ) > "$out/fsstate"
}

# ---------------------------------------------------------------- normalize

normalize() {    # $1=file $2=outdir — strip everything that legitimately varies
  [ -f "$1" ] || { : ; return 0; }
  sed -e "s#$2#<RUN>#g" \
      -e "s#$ROOT#<REPO>#g" \
      -f "$NORMALIZE" "$1"
}

# ---------------------------------------------------------------- commands

cmd_list() {
  printf '%-22s %-10s %s\n' ID FLAGS ARGS
  matrix_rows | while IFS=$'\t' read -r id flags args; do
    printf '%-22s %-10s %s\n' "$id" "$flags" "$args"
  done
}

cmd_run() {
  local id args out
  if [ "${1:-}" = "--" ]; then
    shift; args="$*"; id="adhoc"
  else
    id="${1:?usage: parity run <id> | parity run -- <args…>}"
    local row; row="$(matrix_get "$id")" || die "no such matrix id: $id"
    args="$(printf '%s' "$row" | cut -f2)"
  fi
  out="$(mktemp -d "${TMPDIR:-/tmp}/parity-$id.XXXXXX")"
  # shellcheck disable=SC2086 — matrix args are intentionally word-split
  run_one "$out" $args
  echo "$out"
  echo "--- rc: $(cat "$out/rc")"
  echo "--- stdout:"; normalize "$out/stdout" "$out" | sed 's/^/  /'
  echo "--- stderr:"; normalize "$out/stderr" "$out" | sed 's/^/  /'
  echo "--- trace:";  normalize "$out/trace"  "$out" | sed 's/^/  /'
}

# The Phase 0 deliverable: run every terminating read-only command twice and
# report what still differs after normalize.sed. Residual output IS the work
# list — each line is a nondeterministic field that needs a rule, without which
# every future read-only diff cries wolf.
cmd_mask() {
  local work only="${1:-}"
  work="$(mktemp -d "${TMPDIR:-/tmp}/parity-mask.XXXXXX")"
  matrix_rows | while IFS=$'\t' read -r id flags args; do
    [ -n "$only" ] && [ "$id" != "$only" ] && continue
    case " $flags " in *" skip "*) continue ;; esac
    case " $flags " in *" ro "*) ;; *) continue ;; esac
    printf '%-22s ' "$id"
    local a="$work/$id.a" b="$work/$id.b"
    # shellcheck disable=SC2086
    run_one "$a" $args
    # shellcheck disable=SC2086
    run_one "$b" $args
    local d=""
    for part in rc stdout stderr fsstate; do
      if ! diff -q <(normalize "$a/$part" "$a") <(normalize "$b/$part" "$b") >/dev/null 2>&1; then
        d="$d $part"
      fi
    done
    if [ -n "$d" ]; then
      echo "DIFF:$d"
      for part in $d; do
        # `|| true`: diff exits 1 on difference, which is the expected case here
        # and must not trip pipefail + set -e and abort the sweep.
        { diff <(normalize "$a/$part" "$a") <(normalize "$b/$part" "$b") || true; } \
          | sed -e 's/^/    /' -e "s#^#[$id/$part] #" | head -12 || true
      done
    else
      echo "stable"
    fi
  done
  echo
  echo "work dir: $work"
}

# LEDGER.md is generated so it cannot drift: the command surface comes out of
# bin/rowt itself (run_command's case arms), not out of memory (§6.8).
# Subcommands of one cmd_* function: the arms of the case block that dispatches
# on the first argument. Finding that block matters — taking merely the FIRST
# case picks up cmd_explain's `case "$lane"`, which would invent subcommands
# ("explain block") that do not exist. So: match a case on $1 directly, or on
# the local that was assigned from $1 (cmd_proxy's `action="${1:-status}"`).
subs_of() {      # $1=function name
  local body var
  body="$(sed -n "/^$1()/,/^}/p" "$ROWT")"
  var="$(printf '%s' "$body" \
         | sed -n 's/.*[^a-zA-Z_]\([a-zA-Z_][a-zA-Z0-9_]*\)="\${\{0,1\}1[:}-].*/\1/p' | head -1)"
  printf '%s' "$body" \
    | awk -v v="$var" '
        !seen && /case / && ($0 ~ /case +"?\$\{?1[:}"]/ || (v != "" && $0 ~ "case +\"?\\$" v "\"?")) { seen=1; next }
        seen && /esac/ { exit }
        seen
      ' \
    | sed -n 's/^ *\([a-z"$][a-z0-9|_${}:-]*\)) .*/\1/p' \
    | tr '|' '\n' \
    | grep -Ev '^\*$|^\$|^"|\{|^$' | sort -u
}

# Coverage is two-dimensional: the command, and the subcommand that decides
# whether it mutates. Measuring only the first level would let `watch install`
# and `router down` hide behind `watch status` and `router status` — precisely
# the "commands I remembered to test" failure the ledger exists to prevent.
cmd_ledger() {
  local pairs rows=0 miss=0
  pairs="$(sed -n '/^run_command()/,/^}/p' "$ROWT" \
           | sed -n 's/^ *\([a-z_|-]*\)) *\(cmd_[a-z_]*\).*/\1 \2/p')"
  {
    echo "# Coverage ledger"
    echo
    echo "Generated by \`tests/parity/bin/parity ledger\` — do not hand-edit."
    echo "Source of truth: \`run_command()\` in bin/rowt, expanded by the first"
    echo "\`case\` block of each \`cmd_*\` function so subcommands are measured too."
    echo
    echo "A phase cannot be declared complete while a row in its scope is unchecked."
    echo "Subcommands reached only through a \`*\` catch-all cannot be enumerated"
    echo "from the source and are not listed."
    echo
    echo '| command | in matrix | covered by |'
    echo '|---|---|---|'
    local line arm func c sub hits target
    printf '%s\n' "$pairs" | while read -r arm func; do
      [ -n "$arm" ] || continue
      for c in $(printf '%s' "$arm" | tr '|' ' '); do
        local subs; subs="$(subs_of "$func" || true)"
        if [ -z "$subs" ]; then
          hits="$(matrix_rows | awk -F'\t' -v c="$c" '{n=split($3,a," "); for(i=1;i<=n;i++) if (a[i]!~/=/) {if (a[i]==c) printf "%s ", $1; break}}')"
          [ -n "$hits" ] && printf '| `%s` | yes | %s|\n' "$c" "$hits" || printf '| `%s` | **no** | — |\n' "$c"
        else
          for sub in $subs; do
            target="$c $sub"
            hits="$(matrix_rows | awk -F'\t' -v t="$target" '{n=split($3,a," "); s=""; for(i=1;i<=n;i++) if (a[i]!~/=/) {s=a[i] " " a[i+1]; break} if (s==t) printf "%s ", $1}')"
            [ -n "$hits" ] && printf '| `%s %s` | yes | %s|\n' "$c" "$sub" "$hits" || printf '| `%s %s` | **no** | — |\n' "$c" "$sub"
          done
        fi
      done
    done
  } > "$DIR/LEDGER.md"
  rows="$(grep -c '^| `' "$DIR/LEDGER.md" || true)"
  miss="$(grep -c '| \*\*no\*\* |' "$DIR/LEDGER.md" || true)"
  echo "wrote $DIR/LEDGER.md — $rows rows, $miss uncovered"
}

# Replay the generated corpus through the classifier and emit one verdict per
# destination. In Phase 2 this runs against both implementations and the two
# outputs must be identical; today it produces the bash baseline. One sandbox is
# reused for all of it — building 90-odd sandboxes to ask 90-odd questions would
# make the gate too slow to run often, and a gate you skip is not a gate.
cmd_corpus() {
  local out corpus
  corpus="$(mktemp "${TMPDIR:-/tmp}/parity-corpus.XXXXXX")"
  python3 "$SELF/gen-corpus.py" --lists "$DIR/fixtures/config" > "$corpus"
  out="$(mktemp -d "${TMPDIR:-/tmp}/parity-corpus-run.XXXXXX")"
  make_sandbox "$out"
  while IFS=$'\t' read -r dest why; do
    [ -n "$dest" ] || continue
    # First line of `explain` is 'dest (ip)  ->  LANE   (prose)'; the lane is
    # the verdict, the prose is commentary that Phase 2 compares separately.
    local verdict lane reason
    verdict="$(run_in "$out" explain "$dest")"
    lane="$(printf '%s' "$verdict"   | sed -n '1s/.*->  *\([A-Z]*\).*/\1/p')"
    # The lane alone is a weak gate: four lanes over 92 cases means a classifier
    # that matched the wrong suffix, or matched by resolved IP instead of by
    # suffix, still lands on the right lane. rowt's own 'matched:' line is what
    # distinguishes those, so the golden records it (PORTING.md §6.3).
    reason="$(printf '%s' "$verdict"  | sed -n 's/^ *matched: *//p' | head -1)"
    printf '%s\t%s\t%s\t%s\n' "$dest" "${lane:-?}" "${reason:-?}" "$why"
  done < "$corpus"
  rm -rf "$out" "$corpus"
}

# The committed classifier baseline. `parity golden` fails if today's verdicts
# drift from it; `parity golden --update` re-records them (review the diff — a
# changed verdict is a routing change).
cmd_golden() {
  local g="$DIR/golden/classify.tsv" now
  now="$(mktemp "${TMPDIR:-/tmp}/parity-golden.XXXXXX")"
  cmd_corpus > "$now"
  if [ "${1:-}" = "--update" ]; then
    mkdir -p "$DIR/golden"; mv "$now" "$g"; echo "recorded $(wc -l < "$g" | tr -d ' ') verdicts to $g"; return 0
  fi
  [ -f "$g" ] || die "no golden yet — run: parity golden --update"
  if diff -u "$g" "$now"; then
    echo "classifier golden: $(wc -l < "$g" | tr -d ' ') verdicts, no drift"
    rm -f "$now"
  else
    rm -f "$now"; die "classifier verdicts drifted from the golden (above)"
  fi
}

# Phase 1's gate: the rendered config, bash vs Rust, compared canonically.
#
# Canonical rather than byte-exact because key order is not meaning — but it is
# BLOCKING, because this is the only gate that inspects the artifact being
# rewritten. `explain` cannot stand in for it: it walks the list files and never
# reads the rendered config, so a render that dropped the corp outbound's
# domain_resolver would diff perfectly clean (PORTING.md §6.3).
cmd_render_diff() {   # [VAR=VALUE …]
  local rust="${PARITY_RUST_RENDER:-$ROOT/target/release/rowt-render}"
  [ -x "$rust" ] || die "no rust render at $rust — cargo build --release -p rowt-render"
  local -a ENVS=()
  while [ "$#" -gt 0 ]; do
    case "$1" in [A-Z_]*=*) ENVS+=("$1"); shift ;; *) break ;; esac
  done
  local out rc=0
  out="$(mktemp -d "${TMPDIR:-/tmp}/parity-render.XXXXXX")"
  make_sandbox "$out" "$(scenario_of ${ENVS[@]+"${ENVS[@]}"})"
  local cfg="$out/home/rowt"

  # bash writes host.json + vm.json as a side effect of `render`
  run_in "$out" ${ENVS[@]+"${ENVS[@]}"} render >/dev/null 2>&1 || true
  [ -s "$cfg/host.json" ] || die "bash render produced no host.json"

  local mode
  for mode in host vm; do
    local bash_json="$cfg/host.json"
    [ "$mode" = vm ] && bash_json="$cfg/vm.json"
    # Both sides see the same knobs. The interface is bash's to discover
    # (platform seam), so the Rust side is handed the one the fixtures answer
    # with rather than left to guess.
    env ${ENVS[@]+"${ENVS[@]}"} "$rust" "$mode" --config-dir "$cfg" --iface en0 \
      > "$out/rust-$mode.json" 2>"$out/rust-$mode.err" || {
      echo "  rust render ($mode) failed:"; sed 's/^/    /' "$out/rust-$mode.err"; rc=1; continue
    }
    if diff -u <(jq -S . "$bash_json") <(jq -S . "$out/rust-$mode.json") > "$out/diff-$mode" 2>&1; then
      echo "  $mode: identical"
    else
      echo "  $mode: DIFFERS"
      sed 's/^/    /' "$out/diff-$mode" | head -30
      rc=1
    fi
  done
  [ "$rc" = 0 ] && rm -rf "$out" || echo "  artifacts: $out"
  return "$rc"
}

# Every render case, so one green run means the whole matrix agreed.
cmd_render_matrix() {
  local fails=0 total=0 id rest
  while read -r id rest; do
    case "$id" in ''|'#'*) continue ;; esac
    total=$((total + 1))
    echo "[$id] ${rest:-(defaults)}"
    # shellcheck disable=SC2086
    cmd_render_diff $rest || fails=$((fails + 1))
  done < "$DIR/render-cases.txt"
  echo
  echo "render matrix: $((total - fails))/$total cases identical"
  [ "$fails" -eq 0 ]
}

case "${1:-}" in
  list)   shift; cmd_list "$@" ;;
  corpus) shift; cmd_corpus "$@" ;;
  golden) shift; cmd_golden "$@" ;;
  render-diff)   shift; cmd_render_diff "$@" ;;
  render-matrix) shift; cmd_render_matrix "$@" ;;
  run)    shift; cmd_run "$@" ;;
  mask)   shift; cmd_mask "$@" ;;
  ledger) shift; cmd_ledger "$@" ;;
  *) sed -n '2,30p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
