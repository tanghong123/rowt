#!/usr/bin/env bash
#
# parity — the differential harness (PORTING.md §6.2).
#
# Runs rowt inside a sandbox that cannot touch this machine: XDG_CONFIG_HOME and
# HOME point at a scratch tree, and every effectful or environment-reading
# command is a recorder shim on PATH. Each run captures four artifacts:
#
#   stdout / stderr / rc     what the user sees
#   trace                    every shimmed command, with its argv (§6.4)
#   fsstate                  the config dir afterwards — proves the on-disk
#                            formats invariant instead of asserting it (§6.4)
#
#   parity list              show the command matrix
#   parity run <id>          run one matrix entry, keep the artifacts
#   parity run -- <args…>    run an ad-hoc rowt command line
#   parity mask              bash-vs-bash over the matrix; report what still
#                            differs after normalize.sed (the Phase 0 gate)
#   parity golden            classifier verdicts vs the committed golden
#   parity corpus            replay the generated corpus through the classifier
#   parity render-diff       one render case, bash vs Rust, compared canonically
#   parity render-matrix     every render case (the Phase 1 gate)
#   parity classify-diff     one classifier case, bash vs Rust: lane AND reason
#   parity classify-matrix   every classifier case (the Phase 2 gate)
#   parity lanes-diff        lane-list edits, bash vs Rust: files + messages
#   parity reconcile-diff    corp reconcile, Python vs Rust, over generated cases
#   parity netdetect-diff    scutil --dns parser, Python vs Rust, over generated cases
#   parity vless-diff        share-link parser, Python vs Rust: stdout+stderr+status
#   parity merge-diff        import accumulation, Python vs Rust: the review FILE
#   parity foreign-diff      other clients' config trees, Python vs Rust
#   parity sr-diff           Shadowrocket's plist + rules, Python vs Rust
#   parity geosite-diff      the `add` hint's category lookup, Python vs Rust
#   parity watch-diff        watchdog tick: bash's effects vs the FSM's plan
#   parity platform-diff     the platform layer, compared by the argv it produces
#   parity cli-diff          whole commands through rowt-rs vs the shell
#   parity cli-ledger        how much of the shell rowt-rs can stand in for
#   parity replay-bundle     re-run a captured divergence against the machine
#                            state that produced it
#   parity ledger            regenerate LEDGER.md from bin/rowt
#
# `mask` compares bash against itself — it characterizes, it does not compare
# implementations. The cross-implementation gates are `render-diff`/`render-matrix`
# today, and grow to the whole command surface as later phases port it.
set -euo pipefail

SELF="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIR="$(cd -P "$SELF/.." && pwd)"                 # tests/parity
ROOT="$(cd -P "$DIR/../.." && pwd)"              # repo root
ROWT="${PARITY_ROWT:-$ROOT/bin/rowt}"
MATRIX="$DIR/commands.txt"
NORMALIZE="$DIR/normalize.sed"
TIMEOUT="${PARITY_TIMEOUT:-25}"

# Every command that reads or changes machine state. Anything not listed runs
# for real — fine for jq/awk/python3, which are deterministic given their input.
SHIMS="sudo networksetup launchctl limactl scutil ipconfig ifconfig route netstat
sysctl dscacheutil dig curl open brew tailscale pkill killall softwareupdate
system_profiler security osascript defaults sing-box"

die() { echo "parity: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# Time-box a case AND take down what it spawned, in a session it cannot escape.
# Used as: perl -e "$TMO" <seconds> <cmd> [args…]
#
# Three jobs, and the first two are not the timeout:
#
#   setsid   a new session with no controlling terminal. A command that prompts
#            on /dev/tty — `config import` asks before overwriting — gets an
#            error instead of the operator, whether or not the gate itself was
#            started from a terminal. Same intent as the `< /dev/null` below:
#            the sandbox must not be able to reach outside itself, and a gate
#            whose answer depends on how it was launched is not a gate.
#   kill -$$ SIGALRM kills the process it is delivered to and nothing else. A
#            `<lane> log` case ends in `tail -f`, which bash runs as a CHILD, so
#            the alarm took bash and left the tail running — one per streaming
#            case per run, still there hours later. Signalling the process group
#            takes the tree. (rowt-rs execs into tail, so only the bash side
#            leaked, which is exactly the kind of asymmetry a gate should not
#            have.) The kill runs on the normal path too: a case that exits on
#            its own can still leave something behind.
#   fork     the alarm has to outlive the exec to be able to kill anything, so
#            the timeout lives in a parent that waits rather than in the process
#            being timed. It costs the "Alarm clock" job-control noise the
#            report used to carry: the child dies of TERM inside this wrapper
#            now, and the shell reaping US sees an ordinary exit.
#
# The status is passed through as the shell would report it (128+signal for a
# signal death, 127 for an exec failure) with one substitution: a timeout is
# 142, what the bare `alarm` used to produce, rather than the 143 the group
# TERM would now give.
TMO='
use POSIX ();
use Errno ();
my $t = shift;
POSIX::setsid() > 0 or POSIX::setpgid(0, 0);
$SIG{TERM} = "IGNORE";
my $pid = fork();
defined $pid or exit 127;
if ($pid == 0) { $SIG{TERM} = "DEFAULT"; exec { $ARGV[0] } @ARGV; exit 127 }
my $timedout = 0;
$SIG{ALRM} = sub { $timedout = 1; kill "TERM", -$$ };
alarm $t;
my $got;
do { $got = waitpid($pid, 0) } while ($got < 0 && $!{EINTR});
my $s = $?;
alarm 0;
kill "TERM", -$$;
exit 142 if $timedout;
exit($s & 127 ? 128 + ($s & 127) : $s >> 8);
'

# ---------------------------------------------------------------- matrix

matrix_rows() {  # id<TAB>flags<TAB>args…
  sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$MATRIX" \
    | while read -r id flags args; do printf '%s\t%s\t%s\n' "$id" "$flags" "$args"; done
}

matrix_get() {   # $1=id -> flags<TAB>args
  matrix_rows | awk -F'\t' -v i="$1" '$1==i {print $2 "\t" $3; found=1} END{exit !found}'
}

# ---------------------------------------------------------------- sandbox

# A scenario is a machine state the base fixtures do not describe — the proxy
# already on, a portal episode in progress, a VPN up. It overlays both halves of
# the sandbox: `config/` (what rowt has recorded) and `env/` (what the machine
# answers). Selected from the matrix with PARITY_SCENARIO=<name>.
make_sandbox() { # $1=outdir  [$2=scenario]
  local out="$1" scenario="${2:-}" cfg
  mkdir -p "$out"
  cfg="$out/home/rowt"                       # XDG_CONFIG_HOME=$out/home
  mkdir -p "$cfg" "$out/home" "$out/shims" "$out/env"
  cp -R "$DIR/fixtures/config/." "$cfg/"
  cp -R "$DIR/fixtures/env/." "$out/env/"
  if [ -n "$scenario" ]; then
    [ -d "$DIR/fixtures/scenarios/$scenario" ] || die "no such scenario: $scenario"
    [ -d "$DIR/fixtures/scenarios/$scenario/config" ] && cp -R "$DIR/fixtures/scenarios/$scenario/config/." "$cfg/"
    [ -d "$DIR/fixtures/scenarios/$scenario/env" ]    && cp -R "$DIR/fixtures/scenarios/$scenario/env/." "$out/env/"
    # …and `home/`, for the dotfiles that live beside the config tree rather
    # than inside it. Only the rc files so far, which is enough: an rc that
    # ALREADY has shell integration is the branch where `--install` must decline
    # to add a second copy, and there is no way to reach it from a config
    # fixture.
    [ -d "$DIR/fixtures/scenarios/$scenario/home" ]   && cp -R "$DIR/fixtures/scenarios/$scenario/home/." "$out/home/"
  fi
  # "The router is running" cannot be a static fixture: `host_running` reads a
  # pidfile and then `kill -0`s it, so any pid committed to the repo is either
  # dead or, worse, someone else's. A scenario asks for it with an empty
  # `host.pid.self` marker and gets THIS harness's pid, which is alive for
  # exactly as long as the comparison runs — and is the same pid on both sides.
  if [ -f "$cfg/host.pid.self" ]; then
    echo "$$" > "$cfg/host.pid"; rm -f "$cfg/host.pid.self"
  fi
  mkdir -p "$cfg/bin" "$cfg/log" "$cfg/cache"
  cp "$DIR/fixtures/bin/sing-box" "$cfg/bin/sing-box"
  chmod +x "$cfg/bin/sing-box"
  local s
  for s in $SHIMS; do ln -sf "$DIR/shims/_recorder" "$out/shims/$s"; done
}

scenario_of() { # echo the PARITY_SCENARIO value out of a VAR=VALUE list
  local e
  for e in "$@"; do case "$e" in PARITY_SCENARIO=*) printf '%s' "${e#PARITY_SCENARIO=}"; return 0 ;; esac; done
}

# A matrix entry may lead with VAR=VALUE tokens: some behavior is selected by
# environment rather than argv (ROWT_CAPTIVE_URL picks which portal the watchdog
# sees), and that dimension has to be reachable from the matrix. Parsed inline
# on purpose — a helper would have to return the array through a subshell, which
# silently drops it.
run_in() {       # $1=outdir (sandbox already built)  rest=rowt args — stdout only
  local out="$1"; shift
  local -a ENVS=()
  while [ "$#" -gt 0 ]; do
    case "$1" in [A-Z_]*=*) ENVS+=("$1"); shift ;; *) break ;; esac
  done
  env -i \
    ${ENVS[@]+"${ENVS[@]}"} \
    HOME="$out/home" \
    XDG_CONFIG_HOME="$out/home" \
    PATH="$out/shims:/usr/bin:/bin:/usr/sbin:/sbin" \
    TERM=dumb LC_ALL=C TZ=UTC \
    PARITY_TRACE="$out/trace" \
    PARITY_ENV="$out/env" \
    ROWT_IMPL="${ROWT_IMPL:-bash}" \
    perl -e "$TMO" "$TIMEOUT" \
    bash "$ROWT" "$@" 2>/dev/null || true
}

run_one() {      # $1=outdir  rest=rowt args
  local out="$1"; shift
  local rc=0
  local -a ENVS=()
  while [ "$#" -gt 0 ]; do
    case "$1" in [A-Z_]*=*) ENVS+=("$1"); shift ;; *) break ;; esac
  done
  make_sandbox "$out" "$(scenario_of ${ENVS[@]+"${ENVS[@]}"})"
  # `$TMO` is the same timeout trick rowt itself uses (_tmo), plus the session
  # and process-group handling a `tail -f`-style command needs — it keeps one
  # from wedging the harness, and from outliving it.
  env -i \
    ${ENVS[@]+"${ENVS[@]}"} \
    HOME="$out/home" \
    XDG_CONFIG_HOME="$out/home" \
    PATH="$out/shims:/usr/bin:/bin:/usr/sbin:/sbin" \
    TERM=dumb LC_ALL=C TZ=UTC \
    PARITY_TRACE="$out/trace" \
    PARITY_ENV="$out/env" \
    ROWT_IMPL="${ROWT_IMPL:-bash}" \
    perl -e "$TMO" "$TIMEOUT" \
    bash "$ROWT" "$@" >"$out/stdout" 2>"$out/stderr" || rc=$?
  echo "$rc" > "$out/rc"
  [ -f "$out/trace" ] || : > "$out/trace"   # exists even when nothing was shimmed
  snapshot_fs "$out"
}

snapshot_fs() {  # $1=outdir — the config tree, minus what is volatile by design
  local out="$1" cfg="$1/home/rowt"
  ( cd "$cfg" 2>/dev/null || exit 0
    find . -type f \
      ! -path './log/*' ! -name '*.pid' ! -path './cache/*' ! -path './bin/*' \
      | sort | while read -r f; do
          # Checksum the NORMALIZED content: a file whose body carries a
          # timestamp (rowt report's saved diag) would otherwise differ on every
          # run and drown out the real on-disk-format signal.
          # The MODE travels with it: servers.json, manual.json and the review
          # file hold credentials and are chmod 600 on purpose, and a checksum
          # cannot see a dropped chmod. A port that writes the right bytes with
          # the wrong permissions is a security regression, not a near-miss.
          printf '%s %s  %s\n' \
            "$(normalize "$f" "$out" | cksum | awk '{print $1}')" \
            "$(stat -f %Lp "$f" 2>/dev/null || stat -c %a "$f" 2>/dev/null || echo '?')" \
            "$f"
        done
  ) > "$out/fsstate"
  # The rc files are NOT in the config tree — they live in $HOME beside it — and
  # two commands write them: `shell-init --install` appends the eval block and
  # `uninstall` strips it. Everything above is blind to that, which is precisely
  # how `shell-init --install` reached a release doing nothing at all on the
  # Rust side while every gate stayed green. Depth 1, so the config tree below
  # is not walked a second time; named `~/x` so a divergence reads as the
  # dotfile it is.
  ( cd "$out/home" 2>/dev/null || exit 0
    find . -maxdepth 1 -type f | sort | while read -r f; do
        printf '%s %s  ~%s\n' \
          "$(normalize "$f" "$out" | cksum | awk '{print $1}')" \
          "$(stat -f %Lp "$f" 2>/dev/null || stat -c %a "$f" 2>/dev/null || echo '?')" \
          "${f#.}"
      done
  ) >> "$out/fsstate"
}

# ---------------------------------------------------------------- normalize

# The tree the RUST binary was built in, which is not always $ROOT. The shell
# finds its sidecars relative to bin/rowt ($HERE); rowt-rs finds them relative
# to its own executable. Those are the same directory in every real layout —
# repo checkout or brew prefix — but the selftest runs a COPY of bin/rowt while
# the binary stays put, so the two name the same collector by two paths. Both
# become <REPO>, because "which tree" is not what any of these gates is asking.
rust_root() {
  local b="${PARITY_RUST_CLI:-$ROOT/target/release/rowt-rs}"
  ( cd -P "$(dirname "$b")/../.." 2>/dev/null && pwd ) || true
}

normalize() {    # $1=file $2=outdir — strip everything that legitimately varies
  [ -f "$1" ] || { : ; return 0; }
  local rr; rr="$(rust_root)"
  sed -e "s#$2#<RUN>#g" \
      -e "s#$ROOT#<REPO>#g" \
      ${rr:+-e "s#$rr#<REPO>#g"} \
      -f "$NORMALIZE" "$1"
}

# ---------------------------------------------------------------- commands

cmd_list() {
  printf '%-22s %-10s %s\n' ID FLAGS ARGS
  matrix_rows | while IFS=$'\t' read -r id flags args; do
    printf '%-22s %-10s %s\n' "$id" "$flags" "$args"
  done
}

cmd_run() {
  local id args out
  if [ "${1:-}" = "--" ]; then
    shift; args="$*"; id="adhoc"
  else
    id="${1:?usage: parity run <id> | parity run -- <args…>}"
    local row; row="$(matrix_get "$id")" || die "no such matrix id: $id"
    args="$(printf '%s' "$row" | cut -f2)"
  fi
  out="$(mktemp -d "${TMPDIR:-/tmp}/parity-$id.XXXXXX")"
  # shellcheck disable=SC2086 — matrix args are intentionally word-split
  run_one "$out" $args
  echo "$out"
  echo "--- rc: $(cat "$out/rc")"
  echo "--- stdout:"; normalize "$out/stdout" "$out" | sed 's/^/  /'
  echo "--- stderr:"; normalize "$out/stderr" "$out" | sed 's/^/  /'
  echo "--- trace:";  normalize "$out/trace"  "$out" | sed 's/^/  /'
}

# The Phase 0 deliverable: run every terminating read-only command twice and
# report what still differs after normalize.sed. Residual output IS the work
# list — each line is a nondeterministic field that needs a rule, without which
# every future read-only diff cries wolf.
cmd_mask() {
  local work only="${1:-}"
  work="$(mktemp -d "${TMPDIR:-/tmp}/parity-mask.XXXXXX")"
  matrix_rows | while IFS=$'\t' read -r id flags args; do
    [ -n "$only" ] && [ "$id" != "$only" ] && continue
    case " $flags " in *" skip "*) continue ;; esac
    case " $flags " in *" ro "*) ;; *) continue ;; esac
    printf '%-22s ' "$id"
    local a="$work/$id.a" b="$work/$id.b"
    # shellcheck disable=SC2086
    run_one "$a" $args
    # shellcheck disable=SC2086
    run_one "$b" $args
    local d=""
    for part in rc stdout stderr fsstate; do
      if ! diff -q <(normalize "$a/$part" "$a") <(normalize "$b/$part" "$b") >/dev/null 2>&1; then
        d="$d $part"
      fi
    done
    if [ -n "$d" ]; then
      echo "DIFF:$d"
      for part in $d; do
        # `|| true`: diff exits 1 on difference, which is the expected case here
        # and must not trip pipefail + set -e and abort the sweep.
        { diff <(normalize "$a/$part" "$a") <(normalize "$b/$part" "$b") || true; } \
          | sed -e 's/^/    /' -e "s#^#[$id/$part] #" | head -12 || true
      done
    else
      echo "stable"
    fi
  done
  echo
  echo "work dir: $work"
}

# LEDGER.md is generated so it cannot drift: the command surface comes out of
# bin/rowt itself (run_command's case arms), not out of memory (§6.8).
# Subcommands of one cmd_* function: the arms of the case block that dispatches
# on the first argument. Finding that block matters — taking merely the FIRST
# case picks up cmd_explain's `case "$lane"`, which would invent subcommands
# ("explain block") that do not exist. So: match a case on $1 directly, or on
# the local that was assigned from $1 (cmd_proxy's `action="${1:-status}"`).
subs_of() {      # $1=function name
  local body var
  body="$(sed -n "/^$1()/,/^}/p" "$ROWT")"
  var="$(printf '%s' "$body" \
         | sed -n 's/.*[^a-zA-Z_]\([a-zA-Z_][a-zA-Z0-9_]*\)="\${\{0,1\}1[:}-].*/\1/p' | head -1)"
  printf '%s' "$body" \
    | awk -v v="$var" '
        !seen && /case / && ($0 ~ /case +"?\$\{?1[:}"]/ || (v != "" && $0 ~ "case +\"?\\$" v "\"?")) { seen=1; next }
        seen && /esac/ { exit }
        seen
      ' \
    | sed -n 's/^ *\([a-z"$][a-z0-9|_${}:-]*\)) .*/\1/p' \
    | tr '|' '\n' \
    | grep -Ev '^\*$|^\$|^"|\{|^$' | sort -u
}

# Coverage is two-dimensional: the command, and the subcommand that decides
# whether it mutates. Measuring only the first level would let `watch install`
# and `router down` hide behind `watch status` and `router status` — precisely
# the "commands I remembered to test" failure the ledger exists to prevent.
cmd_ledger() {
  local pairs rows=0 miss=0
  pairs="$(sed -n '/^run_command()/,/^}/p' "$ROWT" \
           | sed -n 's/^ *\([a-z_|-]*\)) *\(cmd_[a-z_]*\).*/\1 \2/p')"
  {
    echo "# Coverage ledger"
    echo
    echo "Generated by \`tests/parity/bin/parity ledger\` — do not hand-edit."
    echo "Source of truth: \`run_command()\` in bin/rowt, expanded by the first"
    echo "\`case\` block of each \`cmd_*\` function so subcommands are measured too."
    echo
    echo "A phase cannot be declared complete while a row in its scope is unchecked."
    echo "Subcommands reached only through a \`*\` catch-all cannot be enumerated"
    echo "from the source and are not listed."
    echo
    echo '| command | in matrix | covered by |'
    echo '|---|---|---|'
    local line arm func c sub hits target
    printf '%s\n' "$pairs" | while read -r arm func; do
      [ -n "$arm" ] || continue
      for c in $(printf '%s' "$arm" | tr '|' ' '); do
        local subs; subs="$(subs_of "$func" || true)"
        if [ -z "$subs" ]; then
          hits="$(matrix_rows | awk -F'\t' -v c="$c" '{n=split($3,a," "); for(i=1;i<=n;i++) if (a[i]!~/=/) {if (a[i]==c) printf "%s ", $1; break}}')"
          [ -n "$hits" ] && printf '| `%s` | yes | %s|\n' "$c" "$hits" || printf '| `%s` | **no** | — |\n' "$c"
        else
          for sub in $subs; do
            target="$c $sub"
            hits="$(matrix_rows | awk -F'\t' -v t="$target" '{n=split($3,a," "); s=""; for(i=1;i<=n;i++) if (a[i]!~/=/) {s=a[i] " " a[i+1]; break} if (s==t) printf "%s ", $1}')"
            [ -n "$hits" ] && printf '| `%s %s` | yes | %s|\n' "$c" "$sub" "$hits" || printf '| `%s %s` | **no** | — |\n' "$c" "$sub"
          done
        fi
      done
    done
  } > "$DIR/LEDGER.md"
  rows="$(grep -c '^| `' "$DIR/LEDGER.md" || true)"
  miss="$(grep -c '| \*\*no\*\* |' "$DIR/LEDGER.md" || true)"
  echo "wrote $DIR/LEDGER.md — $rows rows, $miss uncovered"
}

# Replay the generated corpus through the classifier and emit one verdict per
# destination. In Phase 2 this runs against both implementations and the two
# outputs must be identical; today it produces the bash baseline. One sandbox is
# reused for all of it — building 90-odd sandboxes to ask 90-odd questions would
# make the gate too slow to run often, and a gate you skip is not a gate.
cmd_corpus() {
  local out corpus
  corpus="$(mktemp "${TMPDIR:-/tmp}/parity-corpus.XXXXXX")"
  python3 "$SELF/gen-corpus.py" --lists "$DIR/fixtures/config" > "$corpus"
  out="$(mktemp -d "${TMPDIR:-/tmp}/parity-corpus-run.XXXXXX")"
  make_sandbox "$out"
  while IFS=$'\t' read -r dest why; do
    [ -n "$dest" ] || continue
    # First line of `explain` is 'dest (ip)  ->  LANE   (prose)'; the lane is
    # the verdict, the prose is commentary that Phase 2 compares separately.
    local verdict lane reason
    verdict="$(run_in "$out" explain "$dest")"
    lane="$(printf '%s' "$verdict"   | sed -n '1s/.*->  *\([A-Z]*\).*/\1/p')"
    # The lane alone is a weak gate: four lanes over 92 cases means a classifier
    # that matched the wrong suffix, or matched by resolved IP instead of by
    # suffix, still lands on the right lane. rowt's own 'matched:' line is what
    # distinguishes those, so the golden records it (PORTING.md §6.3).
    reason="$(printf '%s' "$verdict"  | sed -n 's/^ *matched: *//p' | head -1)"
    printf '%s\t%s\t%s\t%s\n' "$dest" "${lane:-?}" "${reason:-?}" "$why"
  done < "$corpus"
  rm -rf "$out" "$corpus"
}

# Phase 2's gate: the classifier, bash vs Rust, over the generated corpus.
#
# Compares (lane, reason) and not just the lane. With four lanes over ~90 cases
# a wrong-suffix match still lands on the right lane most of the time, so the
# lane alone would pass a classifier that is right by accident.
cmd_classify_diff() {   # [VAR=VALUE …]
  local rust="${PARITY_RUST_EXPLAIN:-$ROOT/target/release/rowt-explain}"
  [ -x "$rust" ] || die "no rust explain at $rust — cargo build --release -p rowt-core"
  local -a ENVS=()
  while [ "$#" -gt 0 ]; do
    case "$1" in [A-Z_]*=*) ENVS+=("$1"); shift ;; *) break ;; esac
  done
  local out corpus
  out="$(mktemp -d "${TMPDIR:-/tmp}/parity-classify.XXXXXX")"
  make_sandbox "$out" "$(scenario_of ${ENVS[@]+"${ENVS[@]}"})"
  corpus="$out/corpus.tsv"
  python3 "$SELF/gen-corpus.py" --lists "$out/home/rowt" > "$corpus"

  # bash: one explain per destination, reusing the sandbox
  : > "$out/bash.tsv"
  local dest lane reason verdict
  while IFS=$'\t' read -r dest _; do
    [ -n "$dest" ] || continue
    verdict="$(run_in "$out" ${ENVS[@]+"${ENVS[@]}"} explain "$dest")"
    lane="$(printf '%s' "$verdict" | sed -n '1s/.*->  *\([A-Z]*\).*/\1/p')"
    reason="$(printf '%s' "$verdict" | sed -n 's/^ *matched: *//p' | head -1)"
    printf '%s\t%s\t%s\n' "$dest" "${lane:-?}" "${reason:-?}" >> "$out/bash.tsv"
  done < "$corpus"

  env ${ENVS[@]+"${ENVS[@]}"} "$rust" --config-dir "$out/home/rowt" --corpus "$corpus" \
    > "$out/rust.tsv" 2>"$out/rust.err" || { echo "  rust explain failed:"; sed 's/^/    /' "$out/rust.err"; return 1; }

  if diff -u "$out/bash.tsv" "$out/rust.tsv" > "$out/diff"; then
    echo "  $(wc -l < "$out/bash.tsv" | tr -d ' ') verdicts: identical (lane + reason)"
    rm -rf "$out"; return 0
  fi
  echo "  DIFFERS:"; sed 's/^/    /' "$out/diff" | head -30
  echo "  artifacts: $out"; return 1
}

cmd_classify_matrix() {
  local fails=0 total=0 id rest
  while read -r id rest; do
    case "$id" in ''|'#'*) continue ;; esac
    total=$((total + 1))
    echo "[$id] ${rest:-(defaults)}"
    # shellcheck disable=SC2086
    cmd_classify_diff $rest || fails=$((fails + 1))
  done < "$DIR/classify-cases.txt"
  echo
  echo "classifier matrix: $((total - fails))/$total cases identical"
  [ "$fails" -eq 0 ]
}

# The corp-lane reconcile, Python vs Rust, over generated CIDR cases. This one
# is worth randomizing: it is containment/overlap/collapse arithmetic, which is
# where a reimplementation goes wrong on inputs nobody thought to write down.
cmd_reconcile_diff() { # [count]
  local rust="${PARITY_RUST_RECONCILE:-$ROOT/target/release/rowt-reconcile}"
  local py="$ROOT/config/corp-sync-reconcile.py"
  [ -x "$rust" ] || die "no rust reconcile at $rust — cargo build --release -p rowt-core"
  local work n fails=0 d
  work="$(mktemp -d "${TMPDIR:-/tmp}/parity-reconcile.XXXXXX")"
  n="$(python3 "$SELF/gen-reconcile-cases.py" "$work" "${1:-200}")"
  for d in "$work"/case*; do
    local a="$d/active" h="$d/handadded" b="$d/block" p="$d/private"
    python3 "$py" --active "$a" --handadded "$h" --block "$b" --private "$p" > "$d/py.out" 2>"$d/py.err" || true
    "$rust"       --active "$a" --handadded "$h" --block "$b" --private "$p" > "$d/rs.out" 2>"$d/rs.err" || true
    if ! diff -q "$d/py.out" "$d/rs.out" >/dev/null 2>&1; then
      fails=$((fails + 1))
      if [ "$fails" -le 3 ]; then
        echo "  DIFFERS: $d"
        echo "    active:    $(tr '\n' ' ' < "$a")"
        echo "    handadded: $(tr '\n' ' ' < "$h")"
        echo "    block:     $(tr '\n' ' ' < "$b")"
        diff "$d/py.out" "$d/rs.out" | sed 's/^/    /' | head -12
      fi
    fi
  done
  if [ "$fails" -eq 0 ]; then
    echo "  $n reconcile cases: identical"
    rm -rf "$work"; return 0
  fi
  echo "  $fails/$n cases differ — artifacts: $work"; return 1
}

# net-detect: the Python parser vs the Rust one, over generated `scutil --dns`
# outputs. Compared as BYTES, not as re-parsed JSON — the key order and the
# within-list order are part of the contract (`internal_domains` is first-seen
# order, and corp_suggest shows it to a human in that order).
cmd_netdetect_diff() { # [count]
  local rust="${PARITY_RUST_NETDETECT:-$ROOT/target/release/rowt-netdetect}"
  local py="$ROOT/config/net-detect.py"
  [ -x "$rust" ] || die "no rust netdetect at $rust — cargo build --release -p rowt-core"
  local work n fails=0 d
  work="$(mktemp -d "${TMPDIR:-/tmp}/parity-netdetect.XXXXXX")"
  n="$(python3 "$SELF/gen-scutil-cases.py" "$work" "${1:-200}")"
  for d in "$work"/case*; do
    python3 "$py" --input "$d/scutil" > "$d/py.out" 2>"$d/py.err" || true
    "$rust"       --input "$d/scutil" > "$d/rs.out" 2>"$d/rs.err" || true
    if ! diff -q "$d/py.out" "$d/rs.out" >/dev/null 2>&1; then
      fails=$((fails + 1))
      if [ "$fails" -le 3 ]; then
        echo "  DIFFERS: $d"
        diff "$d/py.out" "$d/rs.out" | sed 's/^/    /' | head -12
      fi
    fi
  done
  if [ "$fails" -eq 0 ]; then
    echo "  $n net-detect cases: identical"
    rm -rf "$work"; return 0
  fi
  echo "  $fails/$n cases differ — artifacts: $work"; return 1
}

# Share links -> sing-box outbounds, Python vs Rust: stdout, stderr AND status.
#
# stderr is not decoration for this one. `server add` and the subscription
# rebuild run the parser with stderr on the user's terminal, so "warning:
# skipping a link (…)" and "note: not importing 'X' — same server as 'Y'" are
# output, and a divergence there is a divergence in what the user is told about
# their own servers. --sub IS exercised, against file:// URLs — urlopen and curl
# both speak it, so the base64-or-plaintext decision that runs for every
# subscription on every reload is covered without touching the network.
#
# One thing is normalized rather than compared: the parenthetical of "vmess link
# is not base64-JSON (…)", which is Python's own JSONDecodeError text. Its
# wording is interpreter-specific (3.13 reworded the trailing-comma case), so
# pinning it would pin the wrong Python — the Formula asks for 3.12. It is safe
# to normalize because it cannot hide a functional difference: a link one
# implementation accepts and the other rejects changes the outbound array on
# stdout, which is compared byte for byte. The count is reported so that a
# growing number of them is visible rather than silent.
cmd_vless_diff() { # [count]
  local rust="${PARITY_RUST_VLESS:-$ROOT/target/release/rowt-vless}"
  local py="$ROOT/config/vless-parse.py"
  [ -x "$rust" ] || die "no rust parser at $rust — cargo build --release -p rowt-core"
  local work n fails=0 squashed=0 d
  # Two normalizations, both for the same reason — the part that is interpreter
  # detail rather than contract. The parenthetical is Python's JSONDecodeError
  # wording; the traceback collapses to `<EXC:Name>`, since frame lines and
  # message phrasing move between point releases while "did this input crash,
  # and with what kind of error" is what keeps a corrupt pool out of the router.
  local squash='
    /^Traceback \(most recent call last\):$/ { t = 1; next }
    t == 1 { if ($0 ~ /^[A-Za-z_][A-Za-z0-9_.]*(:|$)/) last = $0; next }
    { sub(/is not base64-JSON \(.*\)$/, "is not base64-JSON (<json-error>)"); print }
    END { if (t == 1) { n = last; sub(/:.*$/, "", n); print "<EXC:" n ">" } }
  '
  work="$(mktemp -d "${TMPDIR:-/tmp}/parity-vless.XXXXXX")"
  n="$(python3 "$SELF/gen-link-cases.py" "$work" "${1:-400}")"
  for d in "$work"/case*; do
    local args=() line rc
    while IFS= read -r line; do args+=("$line"); done < "$d/argv"
    # COLUMNS is pinned because argparse wraps its usage to the terminal width,
    # so the same error would render differently on a wide screen. PYTHONUTF8
    # is pinned because the Pythons that write with ensure_ascii=False put CJK
    # on stdout raw, and under an ASCII locale that is a UnicodeEncodeError the
    # Rust side has no equivalent of — a gate that only passes for whoever
    # invoked it is not a gate.
    rc=0
    COLUMNS=80 PYTHONUTF8=1 python3 "$py" ${args[@]+"${args[@]}"} < "$d/stdin" \
      > "$d/py.out" 2> "$d/py.err" || rc=$?
    echo "$rc" > "$d/py.rc"
    rc=0
    COLUMNS=80 "$rust" ${args[@]+"${args[@]}"} < "$d/stdin" \
      > "$d/rs.out" 2> "$d/rs.err" || rc=$?
    echo "$rc" > "$d/rs.rc"
    awk "$squash" "$d/py.err" > "$d/py.errn"
    awk "$squash" "$d/rs.err" > "$d/rs.errn"
    cmp -s "$d/py.err" "$d/py.errn" || squashed=$((squashed + 1))
    local bad="" f
    for f in out errn rc; do
      diff -q "$d/py.$f" "$d/rs.$f" >/dev/null 2>&1 || bad="$bad $f"
    done
    if [ -n "$bad" ]; then
      fails=$((fails + 1))
      if [ "$fails" -le 3 ]; then
        echo "  DIFFERS ($bad): $d"
        sed 's/^/    argv: /' "$d/argv"
        # `|| true`: head closing the pipe early is a SIGPIPE that pipefail
        # would otherwise turn into an abort halfway through the corpus.
        for f in $bad; do
          diff "$d/py.$f" "$d/rs.$f" | sed 's/^/      /' | head -10 || true
        done
      fi
    fi
  done
  if [ "$fails" -eq 0 ]; then
    echo "  $n share-link cases: identical (stdout, stderr, status)"
    echo "  ($squashed of them had a traceback or JSONDecodeError normalized)"
    rm -rf "$work"; return 0
  fi
  echo "  $fails/$n cases differ — artifacts: $work"; return 1
}

# The import accumulation, Python vs Rust: the FILE, then the streams.
#
# Unlike the other Python gates the primary output is written in place, and
# `cmd_import` reads it straight back with jq for the table it prints. So each
# case is run twice in two copies of its own directory and the resulting
# --into file is compared as BYTES — `_source`'s position inside an entry and
# the servers/subscriptions/proxy_domains/skipped key order are contract, since
# a human edits this file between the extract and the apply.
#
# Note this file is written with ensure_ascii=FALSE, the opposite of
# vless-parse's — a node name in Chinese stays readable here and is escaped
# there. The byte comparison is what keeps the two from being "unified".
cmd_merge_diff() { # [count]
  local rust="${PARITY_RUST_MERGE:-$ROOT/target/release/rowt-import-merge}"
  local py="$ROOT/config/import-merge.py"
  [ -x "$rust" ] || die "no rust merger at $rust — cargo build --release -p rowt-core"
  local work n fails=0 d
  work="$(mktemp -d "${TMPDIR:-/tmp}/parity-merge.XXXXXX")"
  n="$(python3 "$SELF/gen-merge-cases.py" "$work" "${1:-400}")"
  for d in "$work"/case*; do
    local args=() line rc
    while IFS= read -r line; do args+=("$line"); done < "$d/argv"
    cp -R "$d" "$d.a"; cp -R "$d" "$d.b"
    rc=0
    ( cd "$d.a" && COLUMNS=80 PYTHONUTF8=1 python3 "$py" ${args[@]+"${args[@]}"} < stdin \
      > out 2> err ) || rc=$?
    echo "$rc" > "$d.a/rc"
    rc=0
    ( cd "$d.b" && COLUMNS=80 "$rust" ${args[@]+"${args[@]}"} < stdin \
      > out 2> err ) || rc=$?
    echo "$rc" > "$d.b/rc"
    local bad="" f
    for f in out err rc into.json; do
      # Not `diff -N`: BSD diff only honours it while walking directories, so a
      # `--into -` case (where NEITHER side writes the file) would read as a
      # difference. Absent-on-both is equal; absent-on-one is not.
      if [ -e "$d.a/$f" ] && [ -e "$d.b/$f" ]; then
        cmp -s "$d.a/$f" "$d.b/$f" || bad="$bad $f"
      elif [ -e "$d.a/$f" ] || [ -e "$d.b/$f" ]; then
        bad="$bad $f"
      fi
    done
    if [ -n "$bad" ]; then
      fails=$((fails + 1))
      if [ "$fails" -le 3 ]; then
        echo "  DIFFERS ($bad): $d"
        sed 's/^/    argv: /' "$d/argv"
        for f in $bad; do
          : > "$d.a/$f.x"; : > "$d.b/$f.x"
          [ -e "$d.a/$f" ] && cat "$d.a/$f" > "$d.a/$f.x"
          [ -e "$d.b/$f" ] && cat "$d.b/$f" > "$d.b/$f.x"
          echo "      --- $f"
          diff "$d.a/$f.x" "$d.b/$f.x" | sed 's/^/      /' | head -12 || true
        done
      fi
    else
      rm -rf "$d.a" "$d.b"
    fi
  done
  if [ "$fails" -eq 0 ]; then
    echo "  $n accumulation cases: identical (review file, stdout, stderr, status)"
    rm -rf "$work"; return 0
  fi
  echo "  $fails/$n cases differ — artifacts: $work"; return 1
}

# Other proxy clients into a review, Python vs Rust. The input is a client
# config DIRECTORY, so each case is a whole fake $HOME with a Clash profile
# tree or a V2Box SQLite store inside it — and a PATH that decides whether `yq`
# is present, missing, failing or answering with something that is not JSON.
#
# Tracebacks are normalized to `<EXC:TypeName>` on BOTH sides rather than
# matched line for line: frame lines and message wording are interpreter
# version detail, while "did this input crash, and with what kind of error" is
# the invariant that matters — a port that succeeds where the Python dies
# imports garbage into a server pool. Everything before the traceback still
# compares exactly, so the notes printed on the way to the crash are pinned.
cmd_foreign_diff() { # [count]
  local rust="${PARITY_RUST_FOREIGN:-$ROOT/target/release/rowt-foreign-import}"
  local py="$ROOT/config/foreign-import.py"
  [ -x "$rust" ] || die "no rust importer at $rust — cargo build --release -p rowt-core"
  local work n fails=0 squashed=0 d
  local squash='
    /^Traceback \(most recent call last\):$/ { t = 1; next }
    t == 1 { if ($0 ~ /^[A-Za-z_][A-Za-z0-9_.]*(:|$)/) last = $0; next }
    { print }
    END { if (t == 1) { n = last; sub(/:.*$/, "", n); print "<EXC:" n ">" } }
  '
  work="$(mktemp -d "${TMPDIR:-/tmp}/parity-foreign.XXXXXX")"
  n="$(python3 "$SELF/gen-foreign-cases.py" "$work" "${1:-300}")"
  for d in "$work"/case*; do
    local args=() line rc mode p
    while IFS= read -r line; do args+=("$line"); done < "$d/argv"
    read -r mode < "$d/path_mode"
    # `real` is the machine's own PATH (and its own yq); the others are stub
    # directories carrying python3 and a yq that misbehaves in one way.
    case "$mode" in real) p="$PATH" ;; *) p="$work/bin-$mode" ;; esac
    rc=0
    ( cd "$d" && export HOME="$d/home" PATH="$p" COLUMNS=80 PYTHONUTF8=1
      python3 "$py" ${args[@]+"${args[@]}"} < stdin > py.out 2> py.err ) || rc=$?
    echo "$rc" > "$d/py.rc"
    rc=0
    ( cd "$d" && export HOME="$d/home" PATH="$p" COLUMNS=80
      "$rust" ${args[@]+"${args[@]}"} < stdin > rs.out 2> rs.err ) || rc=$?
    echo "$rc" > "$d/rs.rc"
    awk "$squash" "$d/py.err" > "$d/py.errn"
    awk "$squash" "$d/rs.err" > "$d/rs.errn"
    cmp -s "$d/py.err" "$d/py.errn" || squashed=$((squashed + 1))
    local bad="" f
    for f in out errn rc; do
      cmp -s "$d/py.$f" "$d/rs.$f" || bad="$bad $f"
    done
    if [ -n "$bad" ]; then
      fails=$((fails + 1))
      if [ "$fails" -le 3 ]; then
        echo "  DIFFERS ($bad): $d  [yq: $mode]"
        sed 's/^/    argv: /' "$d/argv"
        for f in $bad; do
          diff "$d/py.$f" "$d/rs.$f" | sed 's/^/      /' | head -12 || true
        done
      fi
    fi
  done
  if [ "$fails" -eq 0 ]; then
    echo "  $n client-tree cases: identical (stdout, stderr, status)"
    echo "  ($squashed of them ended in a traceback, normalized to its type)"
    rm -rf "$work"; return 0
  fi
  echo "  $fails/$n cases differ — artifacts: $work"; return 1
}

# Shadowrocket into a review, Python vs Rust. Each case is a fake $HOME with a
# binary NSKeyedArchiver store and .conf rule files in the places the importer
# globs for them — including stores that have been truncated or byte-flipped,
# where the invariant is that both sides agree on which are still readable.
#
# Tracebacks are normalized to `<EXC:TypeName>` on both sides, for the same
# reason as `foreign-diff`: several inputs really do die, and reproducing THAT
# matters while reproducing CPython's frame lines does not.
cmd_sr_diff() { # [count]
  local rust="${PARITY_RUST_SR:-$ROOT/target/release/rowt-sr-import}"
  local py="$ROOT/config/sr-import.py"
  [ -x "$rust" ] || die "no rust importer at $rust — cargo build --release -p rowt-core"
  local work n fails=0 squashed=0 d
  local squash='
    /^Traceback \(most recent call last\):$/ { t = 1; next }
    t == 1 { if ($0 ~ /^[A-Za-z_][A-Za-z0-9_.]*(:|$)/) last = $0; next }
    { print }
    END { if (t == 1) { n = last; sub(/:.*$/, "", n); print "<EXC:" n ">" } }
  '
  work="$(mktemp -d "${TMPDIR:-/tmp}/parity-sr.XXXXXX")"
  n="$(python3 "$SELF/gen-sr-cases.py" "$work" "${1:-300}")"
  for d in "$work"/case*; do
    local args=() line rc
    while IFS= read -r line; do args+=("$line"); done < "$d/argv"
    rc=0
    ( cd "$d" && export HOME="$d/home" COLUMNS=80 PYTHONUTF8=1
      python3 "$py" ${args[@]+"${args[@]}"} < stdin > py.out 2> py.err ) || rc=$?
    echo "$rc" > "$d/py.rc"
    rc=0
    ( cd "$d" && export HOME="$d/home" COLUMNS=80
      "$rust" ${args[@]+"${args[@]}"} < stdin > rs.out 2> rs.err ) || rc=$?
    echo "$rc" > "$d/rs.rc"
    awk "$squash" "$d/py.err" > "$d/py.errn"
    awk "$squash" "$d/rs.err" > "$d/rs.errn"
    cmp -s "$d/py.err" "$d/py.errn" || squashed=$((squashed + 1))
    local bad="" f
    for f in out errn rc; do
      cmp -s "$d/py.$f" "$d/rs.$f" || bad="$bad $f"
    done
    if [ -n "$bad" ]; then
      fails=$((fails + 1))
      if [ "$fails" -le 3 ]; then
        echo "  DIFFERS ($bad): $d"
        sed 's/^/    argv: /' "$d/argv"
        for f in $bad; do
          diff "$d/py.$f" "$d/rs.$f" | sed 's/^/      /' | head -12 || true
        done
      fi
    fi
  done
  if [ "$fails" -eq 0 ]; then
    echo "  $n Shadowrocket cases: identical (stdout, stderr, status)"
    echo "  ($squashed of them ended in a traceback, normalized to its type)"
    rm -rf "$work"; return 0
  fi
  echo "  $fails/$n cases differ — artifacts: $work"; return 1
}

# The `add` hint's category lookup, Python vs Rust.
#
# Compares the CACHE DIRECTORY as well as the three streams, and that is the
# half worth having: the lookup's whole job is to be silent when the world is
# incomplete, so stdout is empty in most cases and comparing it alone would pass
# two implementations that did nothing. What separates them is the litter they
# leave — a decompiled .json, a zero-byte .srs from a failed download — and the
# next run reads that litter back as "already cached".
#
# Each side gets its OWN copy of the seed for the same reason: the run mutates
# the directory it reads, so sharing one would let whichever ran first decide
# what the second saw.
cmd_geosite_diff() { # [count]
  local rust="${PARITY_RUST_GEOSITE:-$ROOT/target/release/rowt-geosite}"
  local py="$ROOT/config/geosite-lookup.py"
  [ -x "$rust" ] || die "no rust geosite at $rust — cargo build --release -p rowt-core"
  local work n fails=0 d
  work="$(mktemp -d "${TMPDIR:-/tmp}/parity-geosite.XXXXXX")"
  n="$(python3 "$SELF/gen-geosite-cases.py" "$work" "${1:-120}")"
  for d in "$work"/case*; do
    local args=() line
    while IFS= read -r line; do args+=("$line"); done < "$d/argv"
    local side cmd base
    base="$(cat "$d/base")"
    for side in py rs; do
      rm -rf "$d/$side-cache"; cp -R "$d/seed" "$d/$side-cache"
      if [ "$side" = py ]; then cmd=(python3 "$py"); else cmd=("$rust"); fi
      local rc=0
      # Half the cases can fetch (a file:// directory) and half cannot (a port
      # with nothing on it) — the generator explains why both are needed.
      #
      # The proxy variables are cleared, and that is not tidiness: curl and
      # urllib both honour them, so on a machine with rowt actually running,
      # every fetch in here was reaching 127.0.0.1:1 THROUGH the router and
      # failing with a 502 instead of a refused connection. Same verdict, but a
      # gate whose failure mode depends on whether the developer had the proxy
      # on is a gate that will one day disagree with itself.
      ( cd "$d" && HOME="$d" \
          ROWT_CACHE="$d/$side-cache" \
          ROWT_SB="$d/bin/sing-box" \
          ROWT_GEOSITE_BASE="$base" \
          http_proxy= https_proxy= all_proxy= no_proxy= \
          HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY= \
          PYTHONUTF8=1 COLUMNS=80 \
          "${cmd[@]}" ${args[@]+"${args[@]}"} \
          > "$d/$side.out" 2> "$d/$side.err" ) || rc=$?
      echo "$rc" > "$d/$side.rc"
      ( cd "$d/$side-cache" && find . -type f | LC_ALL=C sort | while IFS= read -r f; do
          printf '%s %s\n' "$(wc -c < "$f" | tr -d ' ')" "$f"
        done ) > "$d/$side.tree"
    done
    local bad="" f
    for f in out err rc tree; do
      cmp -s "$d/py.$f" "$d/rs.$f" || bad="$bad $f"
    done
    if [ -n "$bad" ]; then
      fails=$((fails + 1))
      if [ "$fails" -le 3 ]; then
        echo "  DIFFERS ($bad): $d"
        sed 's/^/    argv: /' "$d/argv"
        for f in $bad; do
          diff "$d/py.$f" "$d/rs.$f" | sed 's/^/      /' | head -12 || true
        done
      fi
    fi
  done
  if [ "$fails" -eq 0 ]; then
    echo "  $n geosite-hint cases: identical (stdout, stderr, status, cache tree)"
    rm -rf "$work"; return 0
  fi
  echo "  $fails/$n cases differ — artifacts: $work"; return 1
}

# Lane-list edits, bash vs Rust: the three files afterwards, and the lines the
# user is told. The shell's surrounding effects (geosite fetch, the coverage
# hint, the router reload) are filtered out — they are not set logic.
cmd_lanes_diff() {
  local rust="${PARITY_RUST_LANES:-$ROOT/target/release/rowt-lanes}"
  [ -x "$rust" ] || die "no rust lanes at $rust — cargo build --release -p rowt-core"
  local core='^  (added|already present|removed|not found|skipped|moved out of)|list cleared| \+= '
  local fails=0 total=0 line
  # Read the WHOLE line: the lane name is the first word of the command, not a
  # separate field. Splitting it off sent both sides `rowt add …`, which both
  # rejected identically — a false pass that looked like agreement.
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    total=$((total + 1))
    local A B
    A="$(mktemp -d "${TMPDIR:-/tmp}/parity-lanes-a.XXXXXX")"
    B="$(mktemp -d "${TMPDIR:-/tmp}/parity-lanes-b.XXXXXX")"
    make_sandbox "$A"; make_sandbox "$B"
    # shellcheck disable=SC2086 — the case line is intentionally word-split
    run_in "$A" $line > "$A/out.raw" 2>/dev/null || true
    grep -iE "$core" "$A/out.raw" > "$A/out" 2>/dev/null || : > "$A/out"
    # shellcheck disable=SC2086
    "$rust" --config-dir "$B/home/rowt" $line > "$B/out.raw" 2>/dev/null || true
    grep -iE "$core" "$B/out.raw" > "$B/out" 2>/dev/null || : > "$B/out"
    local bad="" f
    for f in escape-domains.txt corp-domains.txt block-domains.txt; do
      diff -q "$A/home/rowt/$f" "$B/home/rowt/$f" >/dev/null 2>&1 || bad="$bad $f"
    done
    diff -q "$A/out" "$B/out" >/dev/null 2>&1 || bad="$bad messages"
    if [ -n "$bad" ]; then
      fails=$((fails + 1))
      echo "[$line] DIFFERS:$bad"
      for f in $bad; do
        case "$f" in
          messages) diff "$A/out" "$B/out" | sed 's/^/    /' | head -8 ;;
          *)        diff "$A/home/rowt/$f" "$B/home/rowt/$f" | sed 's/^/    /' | head -8 ;;
        esac
      done
      echo "    artifacts: $A $B"
    else
      echo "[$line] identical"
      rm -rf "$A" "$B"
    fi
  done < "$DIR/lanes-cases.txt"
  echo
  echo "lane edits: $((total - fails))/$total cases identical"
  [ "$fails" -eq 0 ]
}

# Phase 3's gate: the watchdog tick, bash's EFFECTS vs Rust's PLAN.
#
# The shell does not emit a plan, so its decisions are read back from what it
# actually did — the lines it wrote to watch.log and the proxy calls in the argv
# trace — and compared with the action list the FSM says it would produce for the
# same world. Each case pairs the parity invocation with the observation
# describing that same world; if the two ever drift apart the case is meaningless,
# so the observation is checked against the sandbox's own captive verdict first.
cmd_watch_diff() {
  local rust="${PARITY_RUST_WATCH:-$ROOT/target/release/rowt-watch-tick}"
  [ -x "$rust" ] || die "no rust planner at $rust — cargo build --release -p rowt-core"
  local fails=0 total=0 case
  for case in "$DIR"/watch-cases/*.json; do
    total=$((total + 1))
    local name; name="$(basename "$case" .json)"
    local run; run="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["_run"])' "$case")"
    local out; out="$(mktemp -d "${TMPDIR:-/tmp}/parity-watch.XXXXXX")"
    # shellcheck disable=SC2086 — the recorded invocation is intentionally split
    run_one "$out" $run

    # bash's decisions, as effects
    sed -e 's/^[0-9-]* [0-9:]*  //' "$out/home/rowt/log/watch.log" 2>/dev/null | sed 's/^/log /' > "$out/bash.acts" || : > "$out/bash.acts"
    grep -qE 'setsocksfirewallproxystate .* off' "$out/trace" 2>/dev/null \
      && echo "captive-proxy-off $(awk '/setsocksfirewallproxystate/{print $(NF-1)}' "$out/trace" | head -1)" >> "$out/bash.acts"
    grep -qE 'setsocksfirewallproxystate .* on' "$out/trace" 2>/dev/null \
      && echo "captive-proxy-on $(awk '/setsocksfirewallproxystate/{print $(NF-1)}' "$out/trace" | head -1)" >> "$out/bash.acts"

    # rust's decisions, as a plan — same vocabulary, minus what the shell does
    # not record (journal/audit go to other files, next is internal)
    "$rust" --obs "$case" 2>/dev/null | grep -E '^(log|captive-proxy-off|captive-proxy-on|clear-stale-proxy) ' > "$out/rust.acts" || : > "$out/rust.acts"

    if diff -u "$out/bash.acts" "$out/rust.acts" > "$out/diff" 2>&1; then
      echo "[$name] identical ($(grep -c . "$out/bash.acts" | tr -d ' ') actions)"
      rm -rf "$out"
    else
      fails=$((fails + 1))
      echo "[$name] DIFFERS"; sed 's/^/    /' "$out/diff" | head -14
      echo "    artifacts: $out"
    fi
  done
  echo
  echo "watchdog tick: $((total - fails))/$total cases identical"
  [ "$fails" -eq 0 ]
}

# The platform layer, compared by ARGV. A cutover that changed what gets executed
# would be a behavior change wearing a refactor's clothes, so both sides run
# under the same recorder shims and the traces must match as sequences.
cmd_platform_diff() {
  local probe="${PARITY_RUST_PROBE:-$ROOT/target/release/rowt-probe}"
  [ -x "$probe" ] || die "no rust probe at $probe — cargo build --release -p rowt-platform"
  local fails=0 total=0 line
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    local id rest shell_expr probe_args
    id="$(printf '%s' "${line%%|*}" | sed -e 's/ *$//')"
    rest="${line#*|}"
    shell_expr="$(printf '%s' "${rest%%|*}" | sed -e 's/^ *//' -e 's/ *$//')"
    probe_args="$(printf '%s' "${rest#*|}" | sed -e 's/^ *//' -e 's/ *$//')"
    total=$((total + 1))
    local A B
    A="$(mktemp -d "${TMPDIR:-/tmp}/parity-plat-a.XXXXXX")"
    B="$(mktemp -d "${TMPDIR:-/tmp}/parity-plat-b.XXXXXX")"
    make_sandbox "$A"; make_sandbox "$B"
    # Source rowt with `version` so main() is a cheap no-op, truncate the trace,
    # then call the helper itself. Running it through `rowt run` would exec a NEW
    # shell where rowt's functions do not exist — which silently compared two
    # unrelated traces the first time this was written.
    env -i HOME="$A/home" XDG_CONFIG_HOME="$A/home" \
        PATH="$A/shims:/usr/bin:/bin:/usr/sbin:/sbin" TERM=dumb LC_ALL=C TZ=UTC \
        PARITY_TRACE="$A/trace" PARITY_ENV="$A/env" \
        bash -c 'source "$0" version >/dev/null 2>&1; : > "$PARITY_TRACE"; '"$shell_expr"' >/dev/null 2>&1 || true' \
        "$ROWT" || true
    # shellcheck disable=SC2086
    env -i HOME="$B/home" XDG_CONFIG_HOME="$B/home" \
        PATH="$B/shims:/usr/bin:/bin:/usr/sbin:/sbin" TERM=dumb LC_ALL=C TZ=UTC \
        PARITY_TRACE="$B/trace" PARITY_ENV="$B/env" \
        "$probe" $probe_args >/dev/null 2>&1 || true
    [ -f "$A/trace" ] || : > "$A/trace"; [ -f "$B/trace" ] || : > "$B/trace"
    if diff -u "$A/trace" "$B/trace" > "$A/diff" 2>&1; then
      echo "[$id] identical ($(grep -c . "$A/trace" | tr -d ' ') calls)"
      rm -rf "$A" "$B"
    else
      fails=$((fails + 1))
      echo "[$id] DIFFERS"; sed 's/^/    /' "$A/diff" | head -16
      echo "    artifacts: $A $B"
    fi
  done < "$DIR/platform-cases.txt"
  echo
  echo "platform argv: $((total - fails))/$total cases identical"
  [ "$fails" -eq 0 ]
}

# The CLI surface, command for command. rowt-rs is built alongside the shell,
# not in place of it, so every command it claims can be proven before anything
# is cut over. Compares stdout and exit status — the whole user-visible result,
# not a projection of it.
cmd_cli_diff() {
  local rs="${PARITY_RUST_CLI:-$ROOT/target/release/rowt-rs}"
  [ -x "$rs" ] || die "no rust cli at $rs — cargo build --release -p rowt-cli"
  local fails=0 total=0 line
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    total=$((total + 1))
    local A B scen="" tmo="$TIMEOUT" unordered=0 cmdline="$line"
    # Leading KEY=VALUE tokens select the machine state (PARITY_SCENARIO) or the
    # alarm (PARITY_TIMEOUT). The second exists for the streaming commands:
    # `<lane> log` is `tail -f`, so BOTH sides must be killed by the alarm and a
    # long default would spend a minute per case proving they hang identically.
    while :; do
      case "$cmdline" in
        PARITY_SCENARIO=*) scen="${cmdline%% *}"; scen="${scen#PARITY_SCENARIO=}"; cmdline="${cmdline#* }" ;;
        PARITY_TIMEOUT=*)  tmo="${cmdline%% *}";  tmo="${tmo#PARITY_TIMEOUT=}";    cmdline="${cmdline#* }" ;;
        PARITY_UNORDERED=1) unordered=1; cmdline="${cmdline#* }" ;;
        *) break ;;
      esac
    done
    A="$(mktemp -d "${TMPDIR:-/tmp}/parity-cli-a.XXXXXX")"
    B="$(mktemp -d "${TMPDIR:-/tmp}/parity-cli-b.XXXXXX")"
    make_sandbox "$A" "$scen"; make_sandbox "$B" "$scen"
    # Invoked directly rather than through run_in, which ends in `|| true` and so
    # reports success for everything — an exit status that is always 0 is not an
    # exit status. A non-zero result is normal here (`proxy check` says no), so
    # both sides capture it instead of letting `set -e` end the sweep.
    #
    # `< /dev/null` is load-bearing. Without it the case inherits THIS loop's
    # stdin, which is the case list: any child that reads stdin swallows a
    # buffer's worth of it, and the loop resumes wherever that child stopped.
    # The failure is silent and looks like nothing — the skipped cases are
    # simply never reported — and it cost 26 of them before it was noticed. It
    # also makes the sandbox honest: a command that would prompt gets EOF here
    # rather than a mouthful of the test suite.
    local arc=0 brc=0
    # `$TMO` for the same reason run_in has it: a case like `<lane> log` ends in
    # `tail -f`, and a gate that can wedge forever is a gate nobody runs. It
    # also puts the case in its own session, which is what makes a command that
    # prompts on /dev/tty answerable here — see the wrapper.
    # shellcheck disable=SC2086 — the case line is intentionally word-split
    # PARITY_BASH_IMPL=rust puts §6.6's wrapper in the path on the BASH side, so
    # the run compares rowt-rs against ITSELF through bin/rowt. That proves one
    # thing only — that the front door is transparent — and it is worth being
    # blunt that a green run here says nothing about whether anything was ported
    # correctly: both sides are the same binary, so a wrong answer matches a
    # wrong answer. What it can catch is a wrapper that drops an argument,
    # mangles the exit status, doubles an audit line, or fails to exec at all.
    # selftest 27 breaks the wrapper on purpose and requires this to notice.
    #
    # ROWT_PY=1 keeps the PYTHONS on the bash side. bin/rowt runs the Rust
    # helpers now, and without this every import case would compare rowt-rs's
    # extractor against rowt-rs's extractor — green, and about nothing. The
    # dedicated gates (vless/merge/foreign/sr/netdetect/geosite-diff) replay the
    # Pythons directly and are unaffected either way; what this preserves is the
    # part only cli-diff sees, which is the extractor's output as it reaches the
    # jq around it, the .tmp→mv, the 0600 and the audit line.
    # PARITY_BASH_IMPL=rust deliberately wins over it: that mode is asking for
    # the wrapper, and the wrapper execs a binary that has no Pythons to go back
    # to. selftest 28 requires this to be the way round it is.
    ( env -i HOME="$A/home" XDG_CONFIG_HOME="$A/home" \
        PATH="$A/shims:/usr/bin:/bin:/usr/sbin:/sbin" TERM=dumb LC_ALL=C TZ=UTC \
        PARITY_TRACE="$A/trace" PARITY_ENV="$A/env" \
        ROWT_PY="${PARITY_BASH_PY:-1}" \
        ${PARITY_BASH_IMPL:+ROWT_IMPL="$PARITY_BASH_IMPL"} \
        perl -e "$TMO" "$tmo" \
        bash "$ROWT" $cmdline > "$A/out" 2>/dev/null < /dev/null ) 2>/dev/null || arc=$?
    # shellcheck disable=SC2086
    # Both sides stay wrapped in a subshell whose stderr is discarded. The
    # wrapper no longer dies of a signal, so the "Alarm clock" notice this was
    # written for is gone — but a case is still free to leave a message on the
    # harness's own stderr on its way out, and the report should carry the
    # comparison, not the debris.
    ( env -i HOME="$B/home" XDG_CONFIG_HOME="$B/home" \
        PATH="$B/shims:/usr/bin:/bin:/usr/sbin:/sbin" TERM=dumb LC_ALL=C TZ=UTC \
        PARITY_TRACE="$B/trace" PARITY_ENV="$B/env" \
        perl -e "$TMO" "$tmo" \
        "$rs" $cmdline > "$B/out" 2>/dev/null < /dev/null ) 2>/dev/null || brc=$?
    echo "$arc" > "$A/rc"; echo "$brc" > "$B/rc"
    local bad="" f
    # Normalised per side, like every other gate: each sandbox has its own
    # mktemp path, and a command that prints where it looked (audit, config)
    # would otherwise "differ" on nothing but that.
    normalize "$A/out" "$A" > "$A/out.n"; normalize "$B/out" "$B" > "$B/out.n"
    diff -q "$A/out.n" "$B/out.n" >/dev/null 2>&1 || bad="$bad stdout"
    [ "$arc" = "$brc" ] || bad="$bad rc($arc/$brc)"
    for f in escape-domains.txt corp-domains.txt block-domains.txt; do
      # `diff -q` on two ABSENT files exits 2, which reads here as "differs" —
      # and after `uninstall --purge` both sides are absent, which is agreement.
      # So compare presence first: identical only when both are gone. One side
      # gone still differs, via diff's own exit 2.
      [ -e "$A/home/rowt/$f" ] || [ -e "$B/home/rowt/$f" ] || continue
      diff -q "$A/home/rowt/$f" "$B/home/rowt/$f" >/dev/null 2>&1 || bad="$bad $f"
    done
    # …and everything ELSE the command left on disk, content AND mode. The three
    # lane files keep their own check because "escape-domains.txt differs" reads
    # better than "fsstate differs"; this covers the rest — servers.json,
    # manual.json, subs.txt, state, import-review.json. Without it, a pool
    # command that prints the right summary and writes nothing passes: what
    # `server add` and `sub rm` DO is write files, and their stdout is a
    # courtesy. Normalized like every other stream, because the file NAMES are
    # content here too: `report` writes diag-<date>-<time>.txt, and two runs
    # seconds apart would otherwise "differ" on the clock.
    snapshot_fs "$A"; snapshot_fs "$B"
    normalize "$A/fsstate" "$A" > "$A/fsstate.n"; normalize "$B/fsstate" "$B" > "$B/fsstate.n"
    diff -q "$A/fsstate.n" "$B/fsstate.n" >/dev/null 2>&1 || bad="$bad fsstate"
    # The argv trace, which stdout cannot see. Half the remaining surface —
    # fetch, ping, use, server, sub, watch — is a thin wrapper over something
    # external: what it PRINTS is nearly nothing, what it RUNS is the whole
    # behavior. Without this, "identical stdout" would certify an empty stub.
    [ -f "$A/trace" ] || : > "$A/trace"; [ -f "$B/trace" ] || : > "$B/trace"
    normalize "$A/trace" "$A" > "$A/trace.n"; normalize "$B/trace" "$B" > "$B/trace.n"
    # A command that fans out (ping, probe) writes its trace from concurrent
    # processes, so the ORDER is whatever the scheduler chose — on both sides.
    # Marked cases compare the trace as a SET. Not the default: for the proxy
    # plane the sequence IS the behavior, and sorting everything would retire a
    # gate that has already caught a reordered protocol list.
    if [ "$unordered" = 1 ]; then
      sort -o "$A/trace.n" "$A/trace.n"; sort -o "$B/trace.n" "$B/trace.n"
    fi
    diff -q "$A/trace.n" "$B/trace.n" >/dev/null 2>&1 || bad="$bad trace"
    # And the audit log, so the BEGIN/END bracketing around mutating commands is
    # proven rather than asserted. The elapsed seconds are wall clock, so they go.
    # Volatile by construction: the clock, the two pids, and the elapsed seconds.
    # The `by=` context field is NOT normalized away — it is the field the audit
    # log exists for (hands-on vs watchdog), so it has to match.
    for f in "$A" "$B"; do
      sed -e 's/^[0-9-]* [0-9:]* [+-][0-9]*  //' -e 's/^pid=[0-9]* ppid=[0-9]* //' \
          -e 's/ ([0-9]*s)$//' \
          "$f/home/rowt/log/audit.log" 2>/dev/null > "$f/audit.raw" || : > "$f/audit.raw"
      # …and then through `normalize`, like every other stream. An ABORT line
      # quotes the message that caused it, and those name files — "no review
      # file at <config>/import-review.json" is the same failure on both sides
      # and two different strings without this.
      normalize "$f/audit.raw" "$f" > "$f/audit.n"
    done
    diff -q "$A/audit.n" "$B/audit.n" >/dev/null 2>&1 || bad="$bad audit"
    if [ -n "$bad" ]; then
      fails=$((fails + 1))
      echo "[$line] DIFFERS:$bad"
      # Every one of these ends in `|| true`: `diff` exits 1 on difference,
      # which is the only reason this branch runs at all, and under `set -e` +
      # `pipefail` that status would abort the sweep at the FIRST divergence —
      # turning a report of everything that differs into a report of one thing.
      case "$bad" in *stdout*) { diff "$A/out.n" "$B/out.n" 2>/dev/null || true; } | sed 's/^/    /' | head -10 ;; esac
      case "$bad" in *trace*)  { diff "$A/trace.n" "$B/trace.n" 2>/dev/null || true; } | sed 's/^/    T /' | head -10 ;; esac
      # Names the file, then shows it: a checksum line tells you WHICH file
      # diverged and nothing about how, and the file is usually small JSON.
      case "$bad" in *fsstate*)
        { diff "$A/fsstate.n" "$B/fsstate.n" 2>/dev/null || true; } | sed 's/^/    F /' | head -8
        { diff "$A/fsstate" "$B/fsstate" 2>/dev/null || true; } \
          | sed -n 's/^[<>] *[0-9]* *[0-9?]*  //p' | sort -u \
          | while IFS= read -r f; do
              # `~/.zshrc` names a file in $HOME, everything else one in the
              # config tree — the two roots snapshot_fs walks.
              case "$f" in "~/"*) f="../${f#\~/}" ;; esac
              { diff <(normalize "$A/home/rowt/$f" "$A") <(normalize "$B/home/rowt/$f" "$B") 2>/dev/null || true; } \
                | sed "s#^#    F $f: #" | head -8
            done ;;
      esac
      case "$bad" in *audit*)  { diff "$A/audit.n" "$B/audit.n" 2>/dev/null || true; } | sed 's/^/    A /' | head -6 ;; esac
      echo "    artifacts: $A $B"
    else
      echo "[$line] identical"
      rm -rf "$A" "$B"
    fi
  # PARITY_CASES exists to iterate on ONE new case without paying for the
  # whole sweep. The ledger reads cli-cases.txt directly, so a shortened list
  # cannot quietly become the published coverage.
  done < "${PARITY_CASES:-$DIR/cli-cases.txt}"
  echo
  echo "cli surface: $((total - fails))/$total commands identical"
  [ "$fails" -eq 0 ]
}

# Replay a divergence bundle the shadow captured on a real machine.
#
# The bundle's env/ holds the RAW command output the observation was built from,
# keyed the way the recorder shim expects — so dropping it into a sandbox makes
# both implementations see exactly the machine that disagreed, offline and as
# many times as you like. A divergence stops being a report and becomes a case.
cmd_replay_bundle() {
  local b="${1:?usage: parity replay-bundle <log/parity/DIR>}"
  [ -d "$b/env" ] || die "no env/ in $b — not a divergence bundle"
  local rust="${PARITY_RUST_WATCH:-$ROOT/target/release/rowt-watch-tick}"
  local out; out="$(mktemp -d "${TMPDIR:-/tmp}/parity-replay.XXXXXX")"
  make_sandbox "$out"
  cp -R "$b/env/." "$out/env/" 2>/dev/null || true
  [ -f "$b/state" ] && cat "$b/state" >> "$out/home/rowt/state"

  echo "=== the machine as it was (captured outputs) ==="
  local f
  for f in "$b"/env/*; do
    printf '  %s\n' "$(basename "$f")"
  done

  # Pin the captive verdict to what the bundle recorded. The shell re-probes on
  # every tick, so without this the replay would classify the portal afresh and
  # take a different branch than the one being debugged — a replay that answers
  # a question you did not ask.
  local cap url
  cap="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["obs"].get("captive",""))' "$b/obs.json" 2>/dev/null || true)"
  case "$cap" in
    captive) url=http://127.0.0.1:8099/portal ;;
    clear)   url=http://127.0.0.1:8099/success ;;
    unknown) url=http://127.0.0.1:9/x ;;
    *)       url="" ;;
  esac
  echo "=== shell, replayed against it (captive pinned to '${cap:-unrecorded}') ==="
  run_in "$out" ${url:+ROWT_CAPTIVE_URL=$url} watch tick >/dev/null 2>&1 || true
  sed -e 's/^[0-9-]* [0-9:]*  //' "$out/home/rowt/log/watch.log" 2>/dev/null | sed 's/^/  /' || echo "  (no decisions)"

  echo "=== what the shell decided when it diverged ==="
  sed 's/^/  /' "$b/actual" 2>/dev/null || echo "  (none)"

  echo "=== rust plan, from the recorded observation ==="
  if [ -x "$rust" ] && [ -f "$b/obs.json" ]; then
    "$rust" --obs "$b/obs.json" 2>&1 | sed 's/^/  /'
  else
    echo "  (no planner built, or no obs.json)"
  fi
  echo
  echo "sandbox kept for poking at: $out"
}

# How much of the shell can rowt-rs actually stand in for? Generated from both
# sides so the answer is measured, never estimated: the arms come out of
# run_command(), the coverage out of rowt-rs's own dispatch, and the "gated"
# column out of cli-cases.txt. A command that rowt-rs handles but nothing
# compares is not ported — it is untested code that happens to exist.
cmd_cli_ledger() {
  local rs_src="$ROOT/crates/rowt-cli/src/main.rs"
  local arms impl gated c
  arms="$(sed -n '/^run_command()/,/^}/p' "$ROWT" | sed -n 's/^ *\([a-z_|-]*\)) *cmd_.*/\1/p' | tr '|' '\n' | sort -u | grep -v '^$')"
  # Read `native()`, not the dispatch `match`. They are different questions: the
  # match says "there is code for this name", native() says "rowt-rs answers it
  # rather than handing it to the shell". Only the second is coverage, and only
  # the second is what the binary actually consults — a ledger generated from
  # anything else is describing a program that isn't running.
  impl="$(sed -n '/^fn native(/,/^}/p' "$rs_src" \
          | grep -oE '"[a-z_-]+"' | tr -d '"' | sort -u)"
  # The names in native() that are NOT command arms (help flags, the hidden
  # splitter, lane sub-arm keywords) simply never match an arm below.
  {
    echo "# rowt-rs readiness"
    echo
    echo "Generated by \`parity cli-ledger\`. rowt-rs is built alongside the shell;"
    echo "this is how much of it could stand in, and how much of that is proven."
    echo
    echo "Every arm RUNS through rowt-rs — the ones it does not answer itself are"
    echo "handed to bin/rowt (PORTING.md §6.6), so the question this table answers"
    echo "is not 'does it work' but 'whose code ran, and what proves it'."
    echo
    echo "  native   rowt-rs answers it        legacy   falls through to the shell"
    echo "  cli-diff byte-compared vs bash    boot-test exercised against real sing-box"
    echo "  (passthrough) = bash vs bash: proves the front door is transparent,"
    echo "                  not that anything was ported"
    echo
    echo '| command | runs in | proven by |'
    echo '|---|---|---|'
    local done_n=0 total=0
    for c in $arms; do
      total=$((total + 1))
      local has="legacy" g="—"
      printf '%s\n' "$impl" | grep -qx "$c" && { has="**native**"; done_n=$((done_n + 1)); }
      # The command must be the FIRST word of a case (after any leading
      # VAR=VALUE), or `status` matches the line `proxy status` and reports
      # itself covered by someone else's test.
      #
      # ALL of them, not just PARITY_SCENARIO — cmd_cli_diff strips three, and
      # stripping one here reported `probe` as ungated while two cases for it
      # sat in the file behind a PARITY_UNORDERED prefix. A coverage table that
      # under-reports is the safer direction to be wrong in, and still wrong.
      awk -v c="$c" '{ while ($1 ~ /^[A-Z_]+=/) { $1=""; sub(/^ +/,"") }
                       if ($1==c) found=1 }
                     END { exit !found }' "$DIR/cli-cases.txt" 2>/dev/null && g="cli-diff"
      # For a legacy arm, cli-diff compares bash against bash — it proves the
      # front door is TRANSPARENT, which is worth knowing and is not the same
      # claim as "the port is correct". Say which one it is.
      [ "$has" = "legacy" ] && [ "$g" = "cli-diff" ] && g="cli-diff (passthrough)"
      # The lifecycle arms cannot be byte-compared — they start processes and
      # dial the network. boot-test runs them against a real sing-box instead,
      # which is weaker as a diff but stronger as evidence, and a bare "—" would
      # read as untested.
      case "$c" in
        up|down|reload|restart|router|render)
          [ "$has" = "legacy" ] || { [ "$g" = "—" ] && g="boot-test" || g="$g + boot-test"; } ;;
      esac
      printf '| `%s` | %s | %s |\n' "$c" "$has" "$g"
    done
    echo
    echo "**$done_n of $total command arms answered natively**; the other $((total - done_n)) run in the shell."
    # An arm is not a sub-arm. `escape` is native for its list edits and legacy
    # for `errors`/`log`, and a table that says only "native" hides exactly the
    # half that is not. The partial arms are the ones native() guards with a
    # sub-command match, so they are read from there rather than listed by hand.
    local partial
    partial="$(sed -n '/^fn native(/,/^}/p' "$rs_src" | awk '/=> matches!/{print}' \
               | grep -oE '"[a-z_-]+"' | tr -d '"' | tr '\n' ' ')"
    if [ -n "$partial" ]; then
      echo
      echo "Partial arms — native for some sub-commands, legacy for the rest."
      echo "\`native()\` in crates/rowt-cli/src/main.rs is the authority:"
      echo
      # From the first arm to the end of the function. The previous form ended
      # each chunk at the next line closing with `),`, which meant every arm
      # BETWEEN two `matches!` arms was dropped — `"metrics" => true,` and the
      # `direct|connections|conns` line were missing from a block this file
      # calls the authority. It also left the braces unbalanced as soon as the
      # last arm ended in `),`.
      sed -n '/^fn native(/,/^}/p' "$rs_src" | sed -n '/=> matches!/,$p' | sed 's/^/    /'
    fi
  } > "$DIR/CLI-LEDGER.md"
  grep -c '| yes |' "$DIR/CLI-LEDGER.md" >/dev/null 2>&1 || true
  tail -2 "$DIR/CLI-LEDGER.md"
  echo "wrote $DIR/CLI-LEDGER.md"
}

# The committed classifier baseline. `parity golden` fails if today's verdicts
# drift from it; `parity golden --update` re-records them (review the diff — a
# changed verdict is a routing change).
cmd_golden() {
  local g="$DIR/golden/classify.tsv" now
  now="$(mktemp "${TMPDIR:-/tmp}/parity-golden.XXXXXX")"
  cmd_corpus > "$now"
  if [ "${1:-}" = "--update" ]; then
    mkdir -p "$DIR/golden"; mv "$now" "$g"; echo "recorded $(wc -l < "$g" | tr -d ' ') verdicts to $g"; return 0
  fi
  [ -f "$g" ] || die "no golden yet — run: parity golden --update"
  if diff -u "$g" "$now"; then
    echo "classifier golden: $(wc -l < "$g" | tr -d ' ') verdicts, no drift"
    rm -f "$now"
  else
    rm -f "$now"; die "classifier verdicts drifted from the golden (above)"
  fi
}

# Phase 1's gate: the rendered config, bash vs Rust, compared canonically.
#
# Canonical rather than byte-exact because key order is not meaning — but it is
# BLOCKING, because this is the only gate that inspects the artifact being
# rewritten. `explain` cannot stand in for it: it walks the list files and never
# reads the rendered config, so a render that dropped the corp outbound's
# domain_resolver would diff perfectly clean (PORTING.md §6.3).
cmd_render_diff() {   # [VAR=VALUE …]
  local rust="${PARITY_RUST_RENDER:-$ROOT/target/release/rowt-render}"
  [ -x "$rust" ] || die "no rust render at $rust — cargo build --release -p rowt-render"
  local -a ENVS=()
  while [ "$#" -gt 0 ]; do
    case "$1" in [A-Z_]*=*) ENVS+=("$1"); shift ;; *) break ;; esac
  done
  local out rc=0
  out="$(mktemp -d "${TMPDIR:-/tmp}/parity-render.XXXXXX")"
  make_sandbox "$out" "$(scenario_of ${ENVS[@]+"${ENVS[@]}"})"
  local cfg="$out/home/rowt"

  # bash writes host.json + vm.json as a side effect of `render`
  run_in "$out" ${ENVS[@]+"${ENVS[@]}"} render >/dev/null 2>&1 || true
  [ -s "$cfg/host.json" ] || die "bash render produced no host.json"

  local mode
  for mode in host vm; do
    local bash_json="$cfg/host.json"
    [ "$mode" = vm ] && bash_json="$cfg/vm.json"
    # Both sides see the same knobs. The interface is bash's to discover
    # (platform seam), so the Rust side is handed the one the fixtures answer
    # with rather than left to guess.
    env ${ENVS[@]+"${ENVS[@]}"} "$rust" "$mode" --config-dir "$cfg" --iface en0 \
      > "$out/rust-$mode.json" 2>"$out/rust-$mode.err" || {
      echo "  rust render ($mode) failed:"; sed 's/^/    /' "$out/rust-$mode.err"; rc=1; continue
    }
    if diff -u <(jq -S . "$bash_json") <(jq -S . "$out/rust-$mode.json") > "$out/diff-$mode" 2>&1; then
      echo "  $mode: identical"
    else
      echo "  $mode: DIFFERS"
      sed 's/^/    /' "$out/diff-$mode" | head -30
      rc=1
    fi
  done
  [ "$rc" = 0 ] && rm -rf "$out" || echo "  artifacts: $out"
  return "$rc"
}

# Every render case, so one green run means the whole matrix agreed.
cmd_render_matrix() {
  local fails=0 total=0 id rest
  while read -r id rest; do
    case "$id" in ''|'#'*) continue ;; esac
    total=$((total + 1))
    echo "[$id] ${rest:-(defaults)}"
    # shellcheck disable=SC2086
    cmd_render_diff $rest || fails=$((fails + 1))
  done < "$DIR/render-cases.txt"
  echo
  echo "render matrix: $((total - fails))/$total cases identical"
  [ "$fails" -eq 0 ]
}

case "${1:-}" in
  list)   shift; cmd_list "$@" ;;
  corpus) shift; cmd_corpus "$@" ;;
  golden) shift; cmd_golden "$@" ;;
  render-diff)     shift; cmd_render_diff "$@" ;;
  classify-diff)   shift; cmd_classify_diff "$@" ;;
  classify-matrix) shift; cmd_classify_matrix "$@" ;;
  reconcile-diff)  shift; cmd_reconcile_diff "$@" ;;
  netdetect-diff)  shift; cmd_netdetect_diff "$@" ;;
  vless-diff)      shift; cmd_vless_diff "$@" ;;
  merge-diff)      shift; cmd_merge_diff "$@" ;;
  foreign-diff)    shift; cmd_foreign_diff "$@" ;;
  sr-diff)         shift; cmd_sr_diff "$@" ;;
  geosite-diff)    shift; cmd_geosite_diff "$@" ;;
  lanes-diff)      shift; cmd_lanes_diff "$@" ;;
  watch-diff)      shift; cmd_watch_diff "$@" ;;
  platform-diff)   shift; cmd_platform_diff "$@" ;;
  cli-diff)        shift; cmd_cli_diff "$@" ;;
  cli-ledger)      shift; cmd_cli_ledger "$@" ;;
  replay-bundle)   shift; cmd_replay_bundle "$@" ;;
  render-matrix)   shift; cmd_render_matrix "$@" ;;
  run)    shift; cmd_run "$@" ;;
  mask)   shift; cmd_mask "$@" ;;
  ledger) shift; cmd_ledger "$@" ;;
  # Ends on the last entry of the list rather than a fixed line number, which
  # had silently stopped printing the last four gates as the list grew.
  *) sed -n '2,/^#   parity ledger/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
