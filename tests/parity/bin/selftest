#!/usr/bin/env bash
#
# selftest — prove the gates can fail.
#
# Every other check in this directory is pass-side: commands stable, goldens
# matching, matrices green. A characterization suite whose only evidence is that
# it agreed with itself has not been shown to detect anything. So this breaks the
# system one way per gate, and fails if a gate stays quiet:
#
#   1/2. move a domain between lanes    -> the classifier golden must fail
#   3.   neuter normalization           -> `mask` must report a diff
#   4.   change the proxy bypass list   -> the proxy_on argv trace must differ
#   5/6. drop the corp domain_resolver  -> render-diff and the shadow must fire
#   7.   reword a classifier reason     -> classify-diff must fire (lane-only misses it)
#   8.   disable the single-lane rule   -> lanes-diff must fire
#   9.   reword a captive log line      -> watch-diff must fire
#   10.  …and the watchdog shadow must record it too
#   11.  drop a proxy protocol           -> platform-diff must fire
#   12.  reword an explain description  -> cli-diff must fire
#   13.  shift the share-link tag index -> vless-diff must fire
#   14.  widen an internal-NS range     -> netdetect-diff must fire
#   15.  keep a display-only sub name    -> merge-diff must fire
#   16.  sort a profile scan as strings  -> foreign-diff must fire
#   17.  unify the two sni precedences   -> foreign-diff must fire
#   18.  prefer uuid over password       -> sr-diff must fire
#   19.  take the OLDEST .conf           -> sr-diff must fire
#   20.  reverse `sub rm 1 2`            -> cli-diff must fire
#   21.  match a manual server by tag    -> cli-diff must fire
#   22.  leak _source into manual.json  -> cli-diff must fire
#   23.  unescape a help page's \$      -> cli-diff must fire
#   24.  (structural) native() must not claim an arm run() cannot answer
#
# Everything happens in a throwaway copy of the repo; the real tree is never
# touched. Run it after changing the harness itself.
set -euo pipefail

SELF="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIR="$(cd -P "$SELF/.." && pwd)"
ROOT="$(cd -P "$DIR/../.." && pwd)"

tmp="$(mktemp -d "${TMPDIR:-/tmp}/parity-selftest.XXXXXX")"
# Every gate below is EXPECTED to fail, and cli-diff keeps both sandboxes of a
# failing case so a real divergence can be examined. Here the divergence is the
# point, so those artifacts are litter — a run left several hundred directories
# behind, and they accumulated across runs. Giving the whole selftest its own
# TMPDIR puts them somewhere that dies with the throwaway tree.
#
# A SIBLING of $tmp, not a directory inside it: `normalize` rewrites the repo
# copy's root to <REPO>, and a sandbox path nested under it would be rewritten
# by that rule before the run-scoped one could claim it.
sandboxes="$(mktemp -d "${TMPDIR:-/tmp}/parity-selftest-tmp.XXXXXX")"
trap 'rm -rf "$tmp" "$sandboxes"' EXIT
export TMPDIR="$sandboxes"
# A cli-diff over just the cases a mutation can reach.
#
# Twice over, this is the right shape. It is faster — the sweep now brings a
# router up in five of its 241 cases, so a full pass takes minutes and every
# step below runs one. And it is a sharper claim: a step that says "cli-diff
# caught the reworded lane description" should be reporting that the explain
# cases caught it, not that SOMETHING among 241 went red. A subset that no
# longer covers the mutation fails loudly here, which is the point.
#
# Each step passes the cases its mutation touches; the pre-mutation baseline
# uses the same subset, or it is checking a different question.
only() {
  local f="$tmp/only.txt"
  printf '%s\n' "$@" > "$f"
  printf '%s' "$f"
}

mkdir -p "$tmp/bin" "$tmp/tests"
cp -R "$DIR" "$tmp/tests/parity"
cp "$ROOT/bin/rowt" "$tmp/bin/rowt"
# The shell locates its sidecars relative to ITSELF ($HERE), while rowt-rs
# locates them relative to its own executable — which stays in the real tree,
# because the throwaway copy has no target/. Copying only bin/rowt therefore
# makes the two disagree about whether rowt-collector exists at all, and
# `_router_stop` pkills it only when it does. Link the sidecar tree so the copy
# is a faithful one; without this, cli-diff fails on a difference the selftest
# itself created.
# The shell locates its sidecars relative to ITSELF ($HERE); rowt-rs locates
# them relative to its own executable, which stays in the real tree because the
# throwaway copy has no target/. Copying only bin/rowt therefore makes the two
# disagree about whether rowt-collector, or the agent skill, or the importers
# exist AT ALL — and several arms branch on exactly that. Link every sidecar
# tree so the copy is a faithful one. Anything added beside bin/rowt in future
# belongs in this list; without it, cli-diff fails on a difference the selftest
# itself created.
# README.md and DESIGN.md are in this list for the same reason as the trees:
# `onboard` prints their paths only `if p.is_file()`, and rowt-rs resolves them
# from the REAL tree while the shell resolves them from this copy. Without them
# the two disagree about whether the guides exist, and cli-diff reports a
# difference the selftest itself created.
for _side in rowt-monitor skills lima target README.md DESIGN.md; do
  [ -e "$ROOT/$_side" ] && ln -sfn "$ROOT/$_side" "$tmp/$_side"
done
# config/ is COPIED rather than linked, because the steps below mutate files
# inside it. A symlink means `perl -i` resolves through it and rewrites the REAL
# repo — which is exactly how a bogus 9.0.0.0/8 internal-nameserver range got
# written into config/net-detect.py and committed. The copy is 300K.
cp -R "$ROOT/config" "$tmp/config"
rm -rf "$tmp/config/__pycache__"
P="$tmp/tests/parity/bin/parity"

pass=0 fail=0
ok()   { echo "  ok   — $*"; pass=$((pass + 1)); }
bad()  { echo "  FAIL — $*"; fail=$((fail + 1)); }

echo "1. baseline (the gates must be quiet before anything is broken)"
if "$P" golden >/dev/null 2>&1; then ok "classifier golden passes unmutated"
else bad "golden already fails before any mutation"; fi

echo "2. move example.com from the escape lane to the corp lane"
cfg="$tmp/tests/parity/fixtures/config"
grep -v '^example\.com$' "$cfg/escape-domains.txt" > "$cfg/e.tmp" && mv "$cfg/e.tmp" "$cfg/escape-domains.txt"
echo 'example.com' >> "$cfg/corp-domains.txt"
if "$P" golden >/dev/null 2>&1; then bad "golden passed after a lane change — it does not gate routing"
else ok "golden caught the lane change"; fi
cp "$DIR/fixtures/config/escape-domains.txt" "$cfg/escape-domains.txt"
cp "$DIR/fixtures/config/corp-domains.txt"   "$cfg/corp-domains.txt"

echo "3a. the diag-filename rule actually collapses two different filenames"
# Tested directly rather than through `mask`: everything volatile here moves on
# a one-second clock, so two fast runs can legitimately land in the same second
# and a timing-dependent probe would flap. The rule itself is deterministic.
n="$tmp/tests/parity/normalize.sed"
sample="diag-20260808-010101.txt
diag-20260808-020202.txt"
uniq_with="$(printf '%s\n' "$sample" | sed -f "$n" | sort -u | wc -l | tr -d ' ')"
grep -v '^s/diag-' "$n" > "$n.tmp" && mv "$n.tmp" "$n"
uniq_without="$(printf '%s\n' "$sample" | sed -f "$n" | sort -u | wc -l | tr -d ' ')"
if [ "$uniq_with" = 1 ] && [ "$uniq_without" = 2 ]; then
  ok "the rule collapses volatile filenames, and its absence is visible"
else
  bad "diag rule is inert (with=$uniq_with without=$uniq_without, want 1 and 2)"
fi
cp "$DIR/normalize.sed" "$n"

echo "3b. neuter the per-run path substitution — mask must go loud"
# Deterministic where the clock is not: two sandboxes never share a mktemp path.
# The substitution is turned into an identity (s#$2#$2#g) rather than deleted —
# deleting the line takes its line-continuation with it, which breaks normalize()
# into a syntax error, and a tool that errors on both sides produces two empty
# outputs that compare equal. That failure mode looks exactly like a silent gate,
# so `bash -n` guards it.
sed -i.bak 's|<RUN>|$2|' "$tmp/tests/parity/bin/parity"
if grep -q '<RUN>' "$tmp/tests/parity/bin/parity"; then
  bad "could not neuter the path substitution (pattern moved?)"
elif ! bash -n "$tmp/tests/parity/bin/parity" 2>/dev/null; then
  bad "the mutation broke parity's syntax — the result would be meaningless"
else
  # Captured, not piped into `grep -q`: grep exits on the first match, the
  # producer dies of SIGPIPE, and `set -o pipefail` then reports the pipeline as
  # failed — so a diff that WAS detected reads as "no diff". This exact trap
  # already ate a sweep in cmd_mask; it is easy to write and invisible once
  # written.
  masked="$("$P" mask report 2>&1 || true)"
  case "$masked" in
    *DIFF*) ok "mask caught output that normalization no longer neutralizes" ;;
    *)      bad "mask stayed quiet with normalization removed — it is not load-bearing" ;;
  esac
fi
cp "$DIR/bin/parity" "$tmp/tests/parity/bin/parity"

echo "4. point a captive-probe host in _proxy_bypass_want somewhere else"
before="$("$P" run proxy_on 2>/dev/null | sed -n '/--- trace:/,$p')"
sed -i.bak 's/detectportal\.firefox\.com/detectportal.example.invalid/' "$tmp/bin/rowt"
if ! grep -q 'detectportal\.example\.invalid' "$tmp/bin/rowt"; then
  bad "could not apply the bypass-list mutation (pattern moved?)"
else
  after="$("$P" run proxy_on 2>/dev/null | sed -n '/--- trace:/,$p')"
  if [ "$before" = "$after" ]; then bad "argv trace identical after changing the bypass list"
  else ok "argv trace caught the bypass-list change"; fi
fi

echo "5. drop domain_resolver from the corp outbound in the jq render"
# The bug class §6.3 was written for: a render that silently loses the corp
# outbound's resolver still classifies every domain to the same lane, so an
# explain-based gate cannot see it. Only comparing the artifact can.
rust="$ROOT/target/release/rowt-render"
if [ ! -x "$rust" ]; then
  echo "  skip — no release build (cargo build --release -p rowt-render)"
else
  export PARITY_RUST_RENDER="$rust"
  if ! "$P" render-diff >/dev/null 2>&1; then
    bad "render-diff already fails before the mutation"
  else
    perl -0pi -e 's/\{type:"direct", tag:"corp", domain_resolver:\{server:"local", strategy:"prefer_ipv4"\}\}/{type:"direct", tag:"corp"}/' "$tmp/bin/rowt"
    if grep -q 'tag:"corp", domain_resolver' "$tmp/bin/rowt"; then
      bad "could not drop domain_resolver (the render moved?)"
    elif "$P" render-diff >/dev/null 2>&1; then
      bad "render-diff passed with the corp resolver dropped — it does not gate the config"
    else
      ok "render-diff caught the dropped corp resolver"
    fi
  fi
fi

echo "6. the render shadow must notice the same mutation"
# Reuses step 5's already-mutated copy. _render_bin looks in \$HERE/bin first,
# so the binary is linked there — otherwise the shadow finds nothing and returns
# quietly, which would read as a pass.
if [ ! -x "$rust" ]; then
  echo "  skip — no release build"
else
  ln -sf "$rust" "$tmp/bin/rowt-render"
  if ! grep -q 'tag:"corp", domain_resolver' "$tmp/bin/rowt"; then
    # Captured whole, then trimmed to the first line: piping into `head` inside
    # a command substitution SIGPIPEs the producer, and pipefail turns that into
    # a failure that `set -e` acts on. Third time this trap has appeared here.
    out="$("$P" run -- ROWT_RENDER_SHADOW=1 render 2>/dev/null || true)"
    out="${out%%$'\n'*}"
    log="$out/home/rowt/log/parity.log"
    if [ -s "$log" ] && grep -q DIVERGED "$log"; then
      ok "the shadow recorded a divergence"
    else
      bad "the shadow stayed silent on a diverging render ($(cat "$log" 2>/dev/null || echo 'no log'))"
    fi
  else
    bad "step 5's mutation is not in place — cannot test the shadow"
  fi
fi

echo "7. reword the classifier's reason without changing any lane"
# Proves the classifier gate compares the REASON and not merely the lane. Every
# destination still routes exactly where it did, so a lane-only comparison would
# sail straight past this.
rexp="$ROOT/target/release/rowt-explain"
if [ ! -x "$rexp" ]; then
  echo "  skip — no release build (cargo build --release -p rowt-core)"
else
  export PARITY_RUST_EXPLAIN="$rexp"
  if ! "$P" classify-diff >/dev/null 2>&1; then
    bad "classify-diff already fails before the mutation"
  else
    sed -i.bak 's/longest-match \${lane}-domains suffix/longest-matching \${lane}-domains suffix/' "$tmp/bin/rowt"
    if ! grep -q 'longest-matching' "$tmp/bin/rowt"; then
      bad "could not reword the reason (the string moved?)"
    elif "$P" classify-diff >/dev/null 2>&1; then
      bad "classify-diff passed with the reason reworded — it only compares lanes"
    else
      ok "classify-diff caught a reason-only change"
    fi
  fi
fi

echo "8. break the single-lane invariant in the shell"
# Adding to one lane must pull the entry out of the others. Disable that and the
# lane files diverge — which is the whole point of comparing files, not messages.
rlanes="$ROOT/target/release/rowt-lanes"
if [ ! -x "$rlanes" ]; then
  echo "  skip — no release build (cargo build --release -p rowt-core)"
else
  export PARITY_RUST_LANES="$rlanes"
  if ! "$P" lanes-diff >/dev/null 2>&1; then
    bad "lanes-diff already fails before the mutation"
  else
    perl -0pi -e 's/^_lane_dedupe\(\) \{/_lane_dedupe() { return 0;/m' "$tmp/bin/rowt"
    if ! grep -q '_lane_dedupe() { return 0;' "$tmp/bin/rowt"; then
      bad "could not disable _lane_dedupe (it moved?)"
    elif "$P" lanes-diff >/dev/null 2>&1; then
      bad "lanes-diff passed with the single-lane invariant disabled"
    else
      ok "lanes-diff caught the broken single-lane invariant"
    fi
  fi
fi

echo "9. reword a captive log line in the shell"
# The watchdog gate reads bash's decisions back out of watch.log, so a changed
# message must surface. Two of its cases compare short action lists, which is
# exactly when a gate can look green without comparing anything.
rwatch="$ROOT/target/release/rowt-watch-tick"
if [ ! -x "$rwatch" ]; then
  echo "  skip — no release build (cargo build --release -p rowt-core)"
else
  export PARITY_RUST_WATCH="$rwatch"
  if ! "$P" watch-diff >/dev/null 2>&1; then
    bad "watch-diff already fails before the mutation"
  else
    sed -i.bak 's/captive portal detected — proxy already off; waiting for login/captive portal detected — proxy already off; awaiting login/' "$tmp/bin/rowt"
    if ! grep -q 'awaiting login' "$tmp/bin/rowt"; then
      bad "could not reword the captive log line (it moved?)"
    elif "$P" watch-diff >/dev/null 2>&1; then
      bad "watch-diff passed with a captive log line reworded"
    else
      ok "watch-diff caught the reworded captive decision"
    fi
  fi
fi

echo "10. the watchdog shadow must notice step 9's mutation"
# Reuses the reworded captive line. _watch_bin looks in $HERE/bin first, so the
# planner is linked there — otherwise the shadow finds nothing, returns quietly,
# and that reads as a pass.
if [ ! -x "$rwatch" ]; then
  echo "  skip — no release build"
else
  ln -sf "$rwatch" "$tmp/bin/rowt-watch-tick"
  if ! grep -q 'awaiting login' "$tmp/bin/rowt"; then
    bad "step 9's mutation is not in place — cannot test the shadow"
  else
    out="$("$P" run -- ROWT_WATCH_SHADOW=1 ROWT_CAPTIVE_URL=http://127.0.0.1:8099/portal watch tick 2>/dev/null || true)"
    out="${out%%$'\n'*}"
    log="$out/home/rowt/log/parity.log"
    if [ -s "$log" ] && grep -q DIVERGED "$log"; then
      ok "the watchdog shadow recorded a divergence"
    else
      bad "the shadow stayed silent on a diverging tick ($(cat "$log" 2>/dev/null || echo 'no log'))"
    fi
  fi
fi

echo "11. drop one protocol from the shell's captive proxy-off"
# The platform gate compares argv as a SEQUENCE, so losing a protocol — which
# would leave HTTPS still proxied behind a portal — has to surface.
rprobe="$ROOT/target/release/rowt-probe"
if [ ! -x "$rprobe" ]; then
  echo "  skip — no release build (cargo build --release -p rowt-platform)"
else
  export PARITY_RUST_PROBE="$rprobe"
  if ! "$P" platform-diff >/dev/null 2>&1; then
    bad "platform-diff already fails before the mutation"
  else
    # matches the post-refactor form: every proxy write goes through _ns_write
    perl -0pi -e 's/^  _ns_write 1 -setsecurewebproxystate "\$1" off.*\n//m' "$tmp/bin/rowt"
    # Counted into a variable, not piped: `grep -c` exits 1 when the count is
    # zero, and under pipefail that turns "the mutation worked" into "it failed".
    # Fourth appearance of this trap in this harness.
    left="$(grep -c '_ns_write 1 -setsecurewebproxystate "\$1" off' "$tmp/bin/rowt" || true)"
    if [ "$left" = 0 ]; then
      if "$P" platform-diff >/dev/null 2>&1; then
        bad "platform-diff passed with a protocol dropped from the captive path"
      else
        ok "platform-diff caught the missing protocol"
      fi
    else
      bad "could not drop the protocol (the captive path moved?)"
    fi
  fi
fi

echo "12. reword an explain lane description in the shell"
# Reset the copy first: the mutations above accumulate, and step 8's disabled
# _lane_dedupe alone is enough to make this step's baseline fail for reasons
# that have nothing to do with what it is testing.
cp "$ROOT/bin/rowt" "$tmp/bin/rowt"
rcli="$ROOT/target/release/rowt-rs"
if [ ! -x "$rcli" ]; then
  echo "  skip — no release build (cargo build --release -p rowt-cli)"
else
  export PARITY_RUST_CLI="$rcli"
  # `unlisted.example` is the load-bearing one: the reworded string is the
  # DIRECT lane's description, and a subset of escape/corp/block cases watches
  # three lanes that never print it. (Chosen wrongly the first time, and this
  # step said so — which is the argument for subsets rather than against them.)
  export PARITY_CASES="$(only 'explain unlisted.example' 'explain example.com' 'explain intranet.corp.example')"
  if ! "$P" cli-diff >/dev/null 2>&1; then
    bad "cli-diff already fails before the mutation"
  else
    sed -i.bak 's/straight out the physical NIC — pass-through/straight out the physical NIC — passthrough/' "$tmp/bin/rowt"
    left="$(grep -c 'NIC — passthrough' "$tmp/bin/rowt" || true)"
    if [ "$left" = 0 ]; then
      bad "could not reword the lane description (it moved?)"
    elif "$P" cli-diff >/dev/null 2>&1; then
      bad "cli-diff passed with an explain description reworded"
    else
      ok "cli-diff caught the reworded lane description"
    fi
  fi
  unset PARITY_CASES
fi

echo "13. shift the tag index in the share-link parser"
if [ ! -x "$ROOT/target/release/rowt-vless" ]; then
  echo "  skip — no release build"
else
  # `enumerate(links, 1)` is what makes a skipped line still consume an index,
  # so an unnamed link on line 3 is `server-3` and not `server-2`. A port that
  # numbers the SURVIVORS instead looks right on every corpus without blank
  # lines — which is to say, on every hand-written test. Shifting the start is
  # the smallest expression of that mistake.
  perl -0pi -e 's/for i, raw in enumerate\(links, 1\):/for i, raw in enumerate(links, 2):/' \
    "$tmp/config/vless-parse.py"
  if ! grep -q 'enumerate(links, 2)' "$tmp/config/vless-parse.py"; then
    bad "could not shift the tag index (parse_many moved?)"
  elif PARITY_RUST_VLESS="$ROOT/target/release/rowt-vless" \
       "$tmp/tests/parity/bin/parity" vless-diff 200 >/dev/null 2>&1; then
    bad "vless-diff passed with the tag index shifted"
  else
    ok "vless-diff caught the shifted tag index"
  fi
fi

echo "14. widen an internal-nameserver range in the Python"
if [ ! -x "$ROOT/target/release/rowt-netdetect" ]; then
  echo "  skip — no release build"
else
  # 9.0.0.0/8 is NOT internal. Adding it makes the Python classify 9.x
  # nameservers as corp while Rust does not — a one-line change to a constant,
  # which is exactly the kind of drift a hand-written port accumulates.
  perl -0pi -e 's/        "6\.0\.0\.0\/12",/        "6.0.0.0\/12",\n        "9.0.0.0\/8",/' "$tmp/config/net-detect.py"
  if ! grep -q '9\.0\.0\.0/8' "$tmp/config/net-detect.py"; then
    bad "could not widen the nameserver range (the table moved?)"
  else
    # Point the gate at the mutated Python by running it from the copied tree.
    if PARITY_RUST_NETDETECT="$ROOT/target/release/rowt-netdetect" \
       "$tmp/tests/parity/bin/parity" netdetect-diff 400 >/dev/null 2>&1; then
      bad "netdetect-diff passed with a widened internal-NS range"
    else
      ok "netdetect-diff caught the widened nameserver range"
    fi
  fi
fi

# ---------------------------------------------------------------------------
# Not a mutation test — a structural one, and the only check here that runs
# nothing. `native()` decides which arms rowt-rs ANSWERS and which it hands to
# the shell, and CLI-LEDGER.md is generated from it. A name listed there that
# `run()` does not implement is the worst of both worlds: it stops falling
# through to bash AND fails, while the published coverage counts it as ported.
# That desync has happened once, so it is a gate now rather than a comment
# asking for care.
#
# Compared statically rather than by invoking each name: several of these arms
# start processes, exec a TUI, or reach for the system proxy, and a self-test
# that has to be trusted not to do those things is not one worth having.
echo "15. keep the display-only name= when normalizing a subscription URL"
if [ ! -x "$ROOT/target/release/rowt-import-merge" ]; then
  echo "  skip — no release build"
else
  # Dropping `name=` is what makes the same subscription, pasted once with a
  # display name and once without, dedup to one entry. A port that forgets it
  # agrees on every URL that has no name= — which is most of them, and all of
  # the ones anybody writes by hand into a test.
  perl -0pi -e 's/if k\.lower\(\) != "name"/if k.lower() != "nam"/' \
    "$tmp/config/import-merge.py"
  if ! grep -q '!= "nam"' "$tmp/config/import-merge.py"; then
    bad "could not neuter the name filter (norm_sub moved?)"
  elif PARITY_RUST_MERGE="$ROOT/target/release/rowt-import-merge" \
       "$tmp/tests/parity/bin/parity" merge-diff 200 >/dev/null 2>&1; then
    bad "merge-diff passed with the display-name filter removed"
  else
    ok "merge-diff caught the kept display name"
  fi
fi

echo "16. sort a profile scan by string instead of by path component"
if [ ! -x "$ROOT/target/release/rowt-foreign-import" ]; then
  echo "  skip — no release build"
else
  # `sorted(root.rglob(...))` compares PurePath, i.e. the parts tuple — so
  # `a/b.yaml` comes before `a-x/c.yaml`, while as strings `a-x/…` wins
  # (`-` is 0x2D and `/` is 0x2F). Sorting the strings instead reverses the
  # order the servers come out of a profile directory, which renames every
  # unnamed one. Both orders look sorted; only one is the Python's.
  perl -0pi -e 's/sorted\(root\.rglob\("\*\.y\*ml"\)\)/sorted(root.rglob("*.y*ml"), key=str)/' \
    "$tmp/config/foreign-import.py"
  if ! grep -q 'key=str' "$tmp/config/foreign-import.py"; then
    bad "could not change the scan order (import_clash_dir moved?)"
  elif PARITY_RUST_FOREIGN="$ROOT/target/release/rowt-foreign-import" \
       "$tmp/tests/parity/bin/parity" foreign-diff 150 >/dev/null 2>&1; then
    bad "foreign-diff passed with the profile scan sorted as strings"
  else
    ok "foreign-diff caught the string-sorted profile scan"
  fi
fi

echo "17. unify the two sni precedences the Python deliberately disagrees on"
if [ ! -x "$ROOT/target/release/rowt-foreign-import" ]; then
  echo "  skip — no release build"
else
  # vless reads `servername or sni`; hysteria2 and anytls read `sni or
  # servername`. A port that notices the asymmetry and "fixes" it changes which
  # name a Reality handshake presents — with no error anywhere, and agreement on
  # every proxy that sets only one of the two, which is nearly all of them.
  cp "$ROOT/config/foreign-import.py" "$tmp/config/foreign-import.py"
  perl -0pi -e 's/"sni": p\.get\("servername"\) or p\.get\("sni"\),/"sni": p.get("sni") or p.get("servername"),/' \
    "$tmp/config/foreign-import.py"
  # hysteria2 and anytls already read in that order, so the mutation is the
  # THIRD occurrence, not the first.
  if [ "$(grep -c '"sni": p.get("sni") or p.get("servername")' "$tmp/config/foreign-import.py")" -lt 3 ]; then
    bad "could not swap the vless sni precedence (clash_proxy_to_link moved?)"
  elif PARITY_RUST_FOREIGN="$ROOT/target/release/rowt-foreign-import" \
       "$tmp/tests/parity/bin/parity" foreign-diff 150 >/dev/null 2>&1; then
    bad "foreign-diff passed with the two sni precedences unified"
  else
    ok "foreign-diff caught the unified sni precedence"
  fi
  cp "$ROOT/config/foreign-import.py" "$tmp/config/foreign-import.py"
fi

echo "18. take the VLESS id from uuid instead of password"
if [ ! -x "$ROOT/target/release/rowt-sr-import" ]; then
  echo "  skip — no release build"
else
  # Shadowrocket stores the real VLESS id in its GENERIC `password` slot — the
  # same one AnyTLS and Shadowsocks use — while `uuid` is its own internal
  # config id. Reading `uuid` first produces outbounds that look completely
  # correct, pass every schema check, and never connect. The Python carries a
  # three-line comment about it, which is exactly the kind of thing a port
  # reads past.
  perl -0pi -e 's/vid = s\.get\("password"\) or s\.get\("uuid"\)/vid = s.get("uuid") or s.get("password")/' \
    "$tmp/config/sr-import.py"
  if ! grep -q 'vid = s.get("uuid")' "$tmp/config/sr-import.py"; then
    bad "could not swap the id preference (_to_vless moved?)"
  elif PARITY_RUST_SR="$ROOT/target/release/rowt-sr-import" \
       "$tmp/tests/parity/bin/parity" sr-diff 150 >/dev/null 2>&1; then
    bad "sr-diff passed with the VLESS id taken from uuid"
  else
    ok "sr-diff caught the id taken from the wrong field"
  fi
  cp "$ROOT/config/sr-import.py" "$tmp/config/sr-import.py"
fi

echo "19. take the oldest matching .conf instead of the newest"
if [ ! -x "$ROOT/target/release/rowt-sr-import" ]; then
  echo "  skip — no release build"
else
  # Three glob patterns are tried in order and the first with any hits wins;
  # WITHIN it the newest file by mtime is the one read. A machine with one
  # .conf agrees whichever way that goes, and a machine that has synced
  # iCloud twice does not.
  perl -0pi -e 's/return max\(hits, key=os\.path\.getmtime\)/return min(hits, key=os.path.getmtime)/' \
    "$tmp/config/sr-import.py"
  if ! grep -q 'min(hits' "$tmp/config/sr-import.py"; then
    bad "could not invert the mtime pick (_find_conf moved?)"
  elif PARITY_RUST_SR="$ROOT/target/release/rowt-sr-import" \
       "$tmp/tests/parity/bin/parity" sr-diff 150 >/dev/null 2>&1; then
    bad "sr-diff passed with the oldest .conf preferred"
  else
    ok "sr-diff caught the oldest-wins rule file pick"
  fi
  cp "$ROOT/config/sr-import.py" "$tmp/config/sr-import.py"
fi

echo "20. remove subscriptions in one pass instead of one at a time"
cp "$ROOT/bin/rowt" "$tmp/bin/rowt"
if [ ! -x "$ROOT/target/release/rowt-rs" ]; then
  echo "  skip — no release build"
else
  # `sub rm 1 2` does NOT remove the first two lines: each argument is applied
  # to the file the previous one left behind, so the second number counts into
  # an already-shortened list. It reads like a bug and it is one, but it is the
  # behavior anyone's notes and scripts were written against, so the port keeps
  # it (PORTING.md §6.7). Reversing the order is the obvious "fix" — and the
  # exact shape of accidental improvement a port makes — so the gate has to see
  # it. Reversing changes the outcome without changing which arguments are used.
  perl -0pi -e 's/local arg tmp; tmp="\$\(mktemp\)"/local arg tmp; tmp="\$(mktemp)"; set -- \$(printf "%s\\n" "\$\@" | tail -r)/' \
    "$tmp/bin/rowt"
  if ! grep -q 'tail -r' "$tmp/bin/rowt"; then
    bad "could not reverse the subscription removal order (subs_remove moved?)"
  elif PARITY_RUST_CLI="$ROOT/target/release/rowt-rs" \
       PARITY_CASES="$(only 'PARITY_SCENARIO=pool-seeded sub rm 1 2' 'PARITY_SCENARIO=pool-seeded sub rm 1')" \
       "$P" cli-diff >/dev/null 2>&1; then
    bad "cli-diff passed with subscription removals applied in reverse"
  else
    ok "cli-diff caught the reordered subscription removal"
  fi
fi

echo "21. match a manual server by tag instead of by endpoint"
cp "$ROOT/bin/rowt" "$tmp/bin/rowt"
if [ ! -x "$ROOT/target/release/rowt-rs" ]; then
  echo "  skip — no release build"
else
  # `server rm <tag>` finds the entry in servers.json — the WORKING set, where
  # tags have been uniquified by combine — and then matches it against the
  # manual set by server and port, because the manual entry may carry a
  # different tag for the same endpoint. Matching by tag on both sides looks
  # like a simplification and quietly refuses every removal whose tag was
  # rewritten, telling the user it came from a subscription.
  perl -0pi -e 's/any\(\.server==\$s and \.server_port==\$p\)/any(.tag==\$s)/' "$tmp/bin/rowt"
  if ! grep -q 'any(.tag==\$s)' "$tmp/bin/rowt"; then
    bad "could not swap the manual-server match (servers_remove moved?)"
  elif PARITY_RUST_CLI="$ROOT/target/release/rowt-rs" \
       PARITY_CASES="$(only 'PARITY_SCENARIO=pool-seeded server rm alpha' \
                            'PARITY_SCENARIO=pool-seeded server rm alpha gamma' \
                            'server rm alpha')" \
       "$P" cli-diff >/dev/null 2>&1; then
    bad "cli-diff passed with manual servers matched by tag"
  else
    ok "cli-diff caught the manual server matched by tag"
  fi
  cp "$ROOT/bin/rowt" "$tmp/bin/rowt"
fi

echo "22. let the review file's _source tag reach manual.json"
cp "$ROOT/bin/rowt" "$tmp/bin/rowt"
if [ ! -x "$ROOT/target/release/rowt-rs" ]; then
  echo "  skip — no release build"
else
  # `_source` says which client an entry came from. It exists so a human can
  # prune the review file by origin, and it must be stripped on the way into
  # manual.json — sing-box is handed those objects and an unknown key is not
  # something to find out about at router start. Dropping the `del` leaves
  # every applied server carrying it, which changes nothing anyone would SEE
  # until the config fails to load.
  perl -0pi -e 's/\(\(\.\[1\]\.servers \/\/ \[\]\) \| map\(del\(\._source\)\)\)/((.[1].servers \/\/ []))/' \
    "$tmp/bin/rowt"
  if grep -q 'map(del(._source))' "$tmp/bin/rowt"; then
    bad "could not drop the _source strip (apply_import moved?)"
  elif PARITY_RUST_CLI="$ROOT/target/release/rowt-rs" \
       PARITY_CASES="$(only 'PARITY_SCENARIO=import-review server import --apply')" \
       "$P" cli-diff >/dev/null 2>&1; then
    bad "cli-diff passed with _source left on applied servers"
  else
    ok "cli-diff caught the _source tag reaching the pool"
  fi
  cp "$ROOT/bin/rowt" "$tmp/bin/rowt"
fi

echo "23. unescape the \$SHELL the shell-init page shows the reader"
cp "$ROOT/bin/rowt" "$tmp/bin/rowt"
if [ ! -x "$ROOT/target/release/rowt-rs" ]; then
  echo "  skip — no release build"
else
  # The help pages are unquoted heredocs, so `\$` is a literal dollar — how a
  # page prints a command for the reader to type rather than the value of a
  # variable. Dropping that one backslash makes bash expand $SHELL, and the
  # page still reads perfectly well either way, which is the whole problem: it
  # is invisible to review and invisible to a gate that spot-checks seven pages
  # out of 32. This is the mutation the per-page cases exist for.
  perl -0pi -e 's/by \\\$SHELL/by \$SHELL/' "$tmp/bin/rowt"
  if grep -qF 'by \$SHELL' "$tmp/bin/rowt"; then
    bad "could not unescape the shell-init page's \$SHELL (help_detail moved?)"
  elif PARITY_RUST_CLI="$ROOT/target/release/rowt-rs" \
       PARITY_CASES="$(only 'help shell-init')" \
       "$P" cli-diff >/dev/null 2>&1; then
    bad "cli-diff passed with a help page's escaped dollar expanded"
  else
    ok "cli-diff caught the unescaped dollar in a help page"
  fi
  cp "$ROOT/bin/rowt" "$tmp/bin/rowt"
fi

echo "24. write the shell integration block to the wrong rc file"
cp "$ROOT/bin/rowt" "$tmp/bin/rowt"
if [ ! -x "$ROOT/target/release/rowt-rs" ]; then
  echo "  skip — no release build"
else
  # `shell-init --install` is the only arm that writes OUTSIDE the config tree,
  # and until snapshot_fs walked $HOME too there was nothing here to see it:
  # stdout is empty, stderr is discarded, the exit status is 0 either way. That
  # is how the Rust side shipped in 3.3.0 answering `--install` with a usage
  # error while every gate stayed green. Sending the block to .bashrc instead of
  # the $SHELL-chosen .zshrc is the smallest change that is still wrong, and it
  # is invisible to everything except the dotfile snapshot.
  #
  # The `*zsh)` branch, which is the one the sandbox actually enters: cases run
  # under `env -i`, but bash assigns $SHELL the passwd entry's login shell when
  # it starts without one, so it sees /bin/zsh and never reaches the fallback.
  # (rowt-rs matches that via `diag::login_shell` rather than reading the bare
  # variable — which is what this mutation would catch if it stopped doing so.)
  perl -0pi -e 's/\*zsh\)  rc="\$HOME\/\.zshrc"/*zsh)  rc="\$HOME\/.bashrc"/' "$tmp/bin/rowt"
  if grep -qF '*zsh)  rc="$HOME/.zshrc"' "$tmp/bin/rowt"; then
    bad "could not repoint the zsh rc target (shell_init_install moved?)"
  elif PARITY_RUST_CLI="$ROOT/target/release/rowt-rs" \
       PARITY_CASES="$(only 'shell-init --install')" \
       "$P" cli-diff >/dev/null 2>&1; then
    bad "cli-diff passed with the integration block written to the wrong rc"
  else
    ok "cli-diff caught the integration block in the wrong rc file"
  fi
  cp "$ROOT/bin/rowt" "$tmp/bin/rowt"
fi

echo "25. every name native() claims must be an arm of run()"
src="$ROOT/crates/rowt-cli/src/main.rs"
# Command names only. A native() arm line is indented exactly eight spaces and
# starts with a pattern; the sub-command lists inside `matches!(…)` are indented
# twelve, and scraping those too would compare command names against lane verbs.
claimed="$(sed -n '/^fn native(/,/^}/p' "$src" | grep -E '^        ["|]' | sed 's/=>.*//' \
           | grep -oE '"[a-z_-]+"' | tr -d '"' | sort -u)"
# Top-level arms only — exactly eight spaces of indent. A nested match inside an
# arm is a different question, and counting its patterns is how the OLD ledger
# managed to report `status` as ported because `proxy` mentioned it.
answered="$(sed -n '/^fn run(/,/^}/p' "$src" | grep -E '^        "' | sed 's/=>.*//' \
            | grep -oE '"[a-z_-]+"' | tr -d '"' | sort -u)"
# Routed before dispatch reaches run(), in main() and shell::dispatch.
preroute="help -h --help --version -V"
missing=""
for n in $claimed; do
  # preroute first, and `grep -x --` after: several of these names begin with a
  # dash, which grep would otherwise read as its own flags.
  case " $preroute " in *" $n "*) continue ;; esac
  printf '%s\n' "$answered" | grep -qxF -- "$n" && continue
  missing="$missing $n"
done
if [ -n "$missing" ]; then
  bad "native() claims arms run() does not answer:$missing"
elif [ -z "$claimed" ] || [ -z "$answered" ]; then
  bad "could not read native()/run() — did the dispatch move?"
else
  ok "native() and run() agree on every claimed arm"
fi

echo
echo "selftest: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
