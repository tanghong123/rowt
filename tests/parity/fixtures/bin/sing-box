#!/usr/bin/env bash
# Fake sing-box for the parity sandbox: enough to satisfy sb_ok()'s version
# gate and to accept `check`/`format` without touching the network.
case "${1:-}" in
  version) echo "sing-box version 1.13.14" ;;
  check|format) exit 0 ;;
  run)
    # A restart under host.pid.self must FAIL on both sides unless the scenario
    # says otherwise: the process exits at once, readiness never sees it, and
    # the arm's failure path runs. env/sing-box-run-stays keeps it up instead,
    # long enough for both sides' readiness probes, so with a canned /version
    # answer the restart comes back and `✓ running` is printed.
    if [ -f "${PARITY_ENV:-}/sing-box-run-stays" ]; then exec sleep 30; fi
    exit 0 ;;
  tools)
    # `tools fetch -c <cfg> -o <tag> <url>` — the delay probe escape-dns runs
    # for each candidate address of a disputed name. Every candidate passes,
    # unless the scenario lists the addresses that may in
    # $PARITY_ENV/sing-box-fetch-pass (one per line).
    shift
    cfg="" tag=""
    while [ "$#" -gt 0 ]; do
      case "$1" in -c) cfg="${2:-}"; shift ;; -o) tag="${2:-}"; shift ;; esac
      shift
    done
    pass="${PARITY_ENV:-}/sing-box-fetch-pass"
    [ -f "$pass" ] || exit 0
    addr="$(jq -r --arg t "$tag" '.outbounds[] | select(.tag == $t) | .server' "$cfg" 2>/dev/null)"
    grep -qxF "$addr" "$pass" ;;
  rule-set)
    # `rule-set decompile <set>.srs -o <out>.json` — what `config export --to
    # shadowrocket` expands a geosite category with, and what the lane-add hint
    # loads a category through. The real tool writes the JSON and exits 0, or
    # exits 1 with nothing written; this one does the same, from a canned
    # answer the scenario ships as $PARITY_ENV/decompile-<set>.json. Without
    # one it FAILS (exit 1), as the real tool does on a file it cannot read —
    # it used to exit 0 and write nothing, which no real sing-box does, and the
    # shell's export then died on an arithmetic error instead of saying the
    # category could not be decompiled. Both lookups (geosite.rs, the Python)
    # treat a failed decompile and a missing JSON alike, so nothing else moves.
    shift
    [ "${1:-}" = decompile ] || exit 0
    shift
    srs="" outp=""
    while [ "$#" -gt 0 ]; do
      case "$1" in -o) outp="${2:-}"; shift ;; *) srs="$1" ;; esac
      shift
    done
    name="$(basename "$srs" .srs)"
    canned="${PARITY_ENV:-}/decompile-$name.json"
    [ -f "$canned" ] && [ -n "$outp" ] || exit 1
    cp "$canned" "$outp" ;;
  *) exit 0 ;;
esac
