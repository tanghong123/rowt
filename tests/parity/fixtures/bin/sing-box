#!/usr/bin/env bash
# Fake sing-box for the parity sandbox: enough to satisfy sb_ok()'s version
# gate and to accept `check`/`format` without touching the network.
case "${1:-}" in
  version) echo "sing-box version 1.13.14" ;;
  check|format) exit 0 ;;
  run)
    # A restart under host.pid.self must FAIL on both sides unless the scenario
    # says otherwise: the process exits at once, readiness never sees it, and
    # the arm's failure path runs. env/sing-box-run-stays keeps it up instead,
    # long enough for both sides' readiness probes, so with a canned /version
    # answer the restart comes back and `✓ running` is printed.
    if [ -f "${PARITY_ENV:-}/sing-box-run-stays" ]; then exec sleep 30; fi
    exit 0 ;;
  tools)
    # `tools fetch -c <cfg> -o <tag> <url>` — the delay probe escape-dns runs
    # for each candidate address of a disputed name. Every candidate passes,
    # unless the scenario lists the addresses that may in
    # $PARITY_ENV/sing-box-fetch-pass (one per line).
    shift
    cfg="" tag=""
    while [ "$#" -gt 0 ]; do
      case "$1" in -c) cfg="${2:-}"; shift ;; -o) tag="${2:-}"; shift ;; esac
      shift
    done
    pass="${PARITY_ENV:-}/sing-box-fetch-pass"
    [ -f "$pass" ] || exit 0
    addr="$(jq -r --arg t "$tag" '.outbounds[] | select(.tag == $t) | .server' "$cfg" 2>/dev/null)"
    grep -qxF "$addr" "$pass" ;;
  *) exit 0 ;;
esac
